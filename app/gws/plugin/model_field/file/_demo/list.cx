uid "field_file_list"

title "Editieren von Dokumenten als Dateiliste"

metadata.keywords [ "edit" "datenbank" ]

metadata.abstract """
Dokumente, die einem POI zugeordnet sind, als Dateiliste im Formular bearbeiten.

Im Reiter "Editieren" das Modell "POIs" wählen und ein Objekt öffnen. Das Feld "Related documents" listet die zugehörigen Dokumente; über die Schaltflächen werden neue Dokumente hochgeladen, bestehende verknüpft oder bearbeitet und Verknüpfungen gelöst.

Die Dokumente sind ein eigenes Modell (Tabelle `edit.document`) mit einem Feld `type "file"`, das den Inhalt in der Spalte `content` und den Dateinamen in `filename` speichert. Das POI-Modell verweist mit einem Feld `type "relatedFeatureList"` über die Spalte `poi_id` darauf.

Das Widget `fileList` zeigt die verknüpften Objekte als Dateien; `toFileField "documentFile"` benennt das Dateifeld des Dokument-Modells. `withNewButton`, `withLinkButton`, `withEditButton` und `withUnlinkButton` schalten die Schaltflächen ein.
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }


map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}

models+ {
    type "postgres"
    uid "model_file_010"
    tableName "edit.document"
    sort+ { fieldName "title" }
    title "Documents"
    isEditable true
    permissions.edit "allow all"

    fields+ { name "id" type "integer" title "Identifier" isPrimaryKey true permissions.edit "deny all" }
    fields+ { name "title" type "text" title "Title" isRequired true textSearch { type "any" } }

    fields+ {
        name "documentFile"
        title "File"
        type "file"
        contentColumn "content"
        nameColumn "filename"
    }

    templates+ {
        subject "feature.title"
        type "html"
        text "{{@if feature.isNew}} New {{@else}} {{title}} {{@end}}"
    }
}

models+ {
    type "postgres"
    uid "model_poi_010"
    tableName "edit.poi_small"
    sort+ { fieldName "name" }
    title "POIs"
    permissions.edit "allow all"
    isEditable true

    fields+ { name "id" type "integer" title "Identifier" isPrimaryKey true permissions.edit "deny all" }
    fields+ { name "name" type "text" title "Object name" isRequired true textSearch { type "any" } }

    fields+ {
        name "docs"
        title "Related documents"
        type "relatedFeatureList"
        fromColumn "id"
        toModel "model_file_010"
        toColumn "poi_id"
        widget {
            type "fileList"
            toFileField "documentFile"
            withNewButton true
            withLinkButton true
            withEditButton true
            withUnlinkButton true
        }
    }

    templates+ {
        subject "feature.title"
        type "html"
        text "{{@if feature.isNew}} Unbenannt {{@else}} {{name}} {{@end}}"
    }
}





{demo_osm_background}
