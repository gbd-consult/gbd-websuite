@def WMS_111
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE WMT_MS_Capabilities SYSTEM "http://schemas.opengis.net/wms/1.1.1/WMS_MS_Capabilities.dtd">
    <WMT_MS_Capabilities version="1.1.1">
        <Service>
            <Name>OGC:WMS</Name>
            <Title>mockmap {self.uid}</Title>
            <OnlineResource xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="{base}?"/>
        </Service>
        <Capability>
            <Request>
                <GetCapabilities>
                    <Format>application/vnd.ogc.wms_xml</Format>
                    <DCPType><HTTP><Get><OnlineResource xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="{base}?"/></Get></HTTP></DCPType>
                </GetCapabilities>
                <GetMap>
                    <Format>image/png</Format>
                    <DCPType><HTTP><Get><OnlineResource xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="{base}?"/></Get></HTTP></DCPType>
                </GetMap>
            </Request>
            <Exception><Format>application/vnd.ogc.se_xml</Format></Exception>
            <Layer>
                <Title>mockmap {self.uid}</Title>
                <SRS>{self.crs.epsg}</SRS>
                <LatLonBoundingBox minx="{self.wgs.minx}" miny="{self.wgs.miny}" maxx="{self.wgs.maxx}" maxy="{self.wgs.maxy}"/>
                <Layer queryable="0">
                    <Name>{self.layer}</Name>
                    <Title>{self.layer}</Title>
                    <SRS>{self.crs.epsg}</SRS>
                    <LatLonBoundingBox minx="{self.wgs.minx}" miny="{self.wgs.miny}" maxx="{self.wgs.maxx}" maxy="{self.wgs.maxy}"/>
                    <BoundingBox SRS="{self.crs.epsg}" minx="{self.bbox.minx}" miny="{self.bbox.miny}" maxx="{self.bbox.maxx}" maxy="{self.bbox.maxy}"/>
                </Layer>
            </Layer>
        </Capability>
    </WMT_MS_Capabilities>
@end

@def WMS_130
    <?xml version="1.0" encoding="UTF-8"?>
    <WMS_Capabilities version="1.3.0" xmlns="http://www.opengis.net/wms" xmlns:xlink="http://www.w3.org/1999/xlink">
        <Service>
            <Name>WMS</Name>
            <Title>mockmap {self.uid}</Title>
            <OnlineResource xlink:href="{base}?"/>
        </Service>
        <Capability>
            <Request>
                <GetCapabilities>
                    <Format>text/xml</Format>
                    <DCPType><HTTP><Get><OnlineResource xlink:href="{base}?"/></Get></HTTP></DCPType>
                </GetCapabilities>
                <GetMap>
                    <Format>image/png</Format>
                    <DCPType><HTTP><Get><OnlineResource xlink:href="{base}?"/></Get></HTTP></DCPType>
                </GetMap>
            </Request>
            <Exception><Format>XML</Format></Exception>
            <Layer>
                <Title>mockmap {self.uid}</Title>
                <CRS>{self.crs.epsg}</CRS>
                <EX_GeographicBoundingBox>
                    <westBoundLongitude>{self.wgs.minx}</westBoundLongitude>
                    <eastBoundLongitude>{self.wgs.maxx}</eastBoundLongitude>
                    <southBoundLatitude>{self.wgs.miny}</southBoundLatitude>
                    <northBoundLatitude>{self.wgs.maxy}</northBoundLatitude>
                </EX_GeographicBoundingBox>
                <Layer queryable="0">
                    <Name>{self.layer}</Name>
                    <Title>{self.layer}</Title>
                    <CRS>{self.crs.epsg}</CRS>
                    <EX_GeographicBoundingBox>
                        <westBoundLongitude>{self.wgs.minx}</westBoundLongitude>
                        <eastBoundLongitude>{self.wgs.maxx}</eastBoundLongitude>
                        <southBoundLatitude>{self.wgs.miny}</southBoundLatitude>
                        <northBoundLatitude>{self.wgs.maxy}</northBoundLatitude>
                    </EX_GeographicBoundingBox>
                    <BoundingBox CRS="{self.crs.epsg}" minx="{self.bbox.minx}" miny="{self.bbox.miny}" maxx="{self.bbox.maxx}" maxy="{self.bbox.maxy}"/>
                </Layer>
            </Layer>
        </Capability>
    </WMS_Capabilities>
@end

@def WMTS
    <?xml version="1.0" encoding="UTF-8"?>
    <Capabilities version="1.0.0"
            xmlns="http://www.opengis.net/wmts/1.0"
            xmlns:ows="http://www.opengis.net/ows/1.1"
            xmlns:xlink="http://www.w3.org/1999/xlink">
        <ows:ServiceIdentification>
            <ows:Title>mockmap {self.uid}</ows:Title>
            <ows:ServiceType>OGC WMTS</ows:ServiceType>
            <ows:ServiceTypeVersion>1.0.0</ows:ServiceTypeVersion>
        </ows:ServiceIdentification>
        <ows:OperationsMetadata>
        @if self.restful
            <ows:Operation name="GetCapabilities">
                <ows:DCP><ows:HTTP><ows:Get xlink:href="{base}/"><ows:Constraint name="GetEncoding">
                    <ows:AllowedValues><ows:Value>RESTful</ows:Value></ows:AllowedValues>
                </ows:Constraint></ows:Get></ows:HTTP></ows:DCP>
            </ows:Operation>
        @else
            <ows:Operation name="GetCapabilities">
                <ows:DCP><ows:HTTP><ows:Get xlink:href="{base}?"><ows:Constraint name="GetEncoding">
                    <ows:AllowedValues><ows:Value>KVP</ows:Value></ows:AllowedValues>
                </ows:Constraint></ows:Get></ows:HTTP></ows:DCP>
            </ows:Operation>
            <ows:Operation name="GetTile">
                <ows:DCP><ows:HTTP><ows:Get xlink:href="{base}?"><ows:Constraint name="GetEncoding">
                    <ows:AllowedValues><ows:Value>KVP</ows:Value></ows:AllowedValues>
                </ows:Constraint></ows:Get></ows:HTTP></ows:DCP>
            </ows:Operation>
        @end
        </ows:OperationsMetadata>
        <Contents>
            <Layer>
                <ows:Title>{self.layer}</ows:Title>
                <ows:Identifier>{self.layer}</ows:Identifier>
                <ows:WGS84BoundingBox>
                    <ows:LowerCorner>{self.wgs.minx} {self.wgs.miny}</ows:LowerCorner>
                    <ows:UpperCorner>{self.wgs.maxx} {self.wgs.maxy}</ows:UpperCorner>
                </ows:WGS84BoundingBox>
                <Style isDefault="true"><ows:Identifier>{self.style}</ows:Identifier></Style>
                <Format>image/png</Format>
                <TileMatrixSetLink><TileMatrixSet>{self.tms.uid}</TileMatrixSet></TileMatrixSetLink>
                @if self.restful
                    <ResourceURL format="image/png" resourceType="tile"
                        template="{base}/{self.layer}/{self.style}/{self.tms.uid}/{{TileMatrix}}/{{TileRow}}/{{TileCol}}.png"/>
                @end
            </Layer>
            <TileMatrixSet>
                <ows:Identifier>{self.tms.uid}</ows:Identifier>
                <ows:SupportedCRS>{self.tms.crs.urn}</ows:SupportedCRS>
                @for m in self.tms.matrices
                    <TileMatrix>
                        <ows:Identifier>{m.z}</ows:Identifier>
                        <ScaleDenominator>{m.scaleDenominator}</ScaleDenominator>
                        <TopLeftCorner>{m.topLeftCorner}</TopLeftCorner>
                        <TileWidth>{self.tms.tileSize}</TileWidth>
                        <TileHeight>{self.tms.tileSize}</TileHeight>
                        <MatrixWidth>{m.matrixWidth}</MatrixWidth>
                        <MatrixHeight>{m.matrixHeight}</MatrixHeight>
                    </TileMatrix>
                @end
            </TileMatrixSet>
        </Contents>
    </Capabilities>
@end

@def TMS_SERVICE
    <?xml version="1.0" encoding="UTF-8"?>
    <TileMapService version="1.0.0">
        <Title>mockmap {self.uid}</Title>
        <TileMaps>
            <TileMap title="{self.layer}" srs="{self.crs.epsg}" profile="local" href="{base}/1.0.0/{self.layer}"/>
        </TileMaps>
    </TileMapService>
@end

@def TMS_MAP
    <?xml version="1.0" encoding="UTF-8"?>
    <TileMap version="1.0.0" tilemapservice="{base}/1.0.0">
        <Title>{self.layer}</Title>
        <SRS>{self.tms.crs.epsg}</SRS>
        <BoundingBox minx="{self.tms.bbox.minx}" miny="{self.tms.bbox.miny}" maxx="{self.tms.bbox.maxx}" maxy="{self.tms.bbox.maxy}"/>
        <Origin x="{self.tms.originX}" y="{self.tms.originY}"/>
        <TileFormat width="{self.tms.tileSize}" height="{self.tms.tileSize}" mime-type="image/png" extension="png"/>
        <TileSets profile="local">
            @for m in self.tms.matrices
                <TileSet href="{base}/1.0.0/{self.layer}/{m.z}" units-per-pixel="{m.resolution}" order="{m.z}"/>
            @end
        </TileSets>
    </TileMap>
@end