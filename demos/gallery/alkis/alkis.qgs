      <id>Beschriftungen__Rechtliche_Festlegungen__93c0c719_9f70_4d90_b195_425e7bb34422</id>
      <datasource>service='DB_ALKIS' key='ogc_fid' estimatedmetadata=true srid=25832 type=MultiPoint checkPrimaryKeyUnicity='0' table="(SELECT ogc_fid,layer,CASE WHEN grad_pt&lt;0 THEN abs(s.grad_pt) ELSE 0.25*coalesce(skalierung,1)*s.grad_pt*1.3225 END AS tsize,CASE WHEN grad_pt&lt;0 THEN 'Point' ELSE 'MapUnit' END AS tunit,text,CASE coalesce(po_labels.horizontaleausrichtung,s.horizontaleausrichtung) WHEN 'linksbündig' THEN 'Left' WHEN 'rechtsbündig' THEN 'Right' ELSE 'Center' END AS halign,CASE coalesce(po_labels.vertikaleausrichtung,s.vertikaleausrichtung) WHEN 'oben' THEN 'Cap' WHEN 'Basis' THEN 'Base' ELSE 'Half' END AS valign,coalesce(s.art,'Arial'::text) AS family,CASE WHEN s.stil LIKE '%Kursiv%' THEN 1 ELSE 0 END AS italic,CASE WHEN s.stil LIKE '%Fett%' THEN 1 ELSE 0 END AS bold,coalesce(sperrung_pt*0.25,0) AS fontsperrung,replace(f.umn,' ',',') AS tcolor,CASE WHEN grad_pt&lt;0 THEN 0 ELSE 1 END AS tshow,point,st_x(point) AS tx,st_y(point) AS ty,drehwinkel_grad AS tangle FROM \"alkis\".po_labels LEFT OUTER JOIN \"alkis\".alkis_schriften s ON po_labels.signaturnummer=s.signaturnummer AND s.katalog=1 LEFT OUTER JOIN \"alkis\".alkis_farben f ON s.farbe=f.id WHERE thema='Rechtliche Festlegungen' AND modell &amp;&amp; ARRAY['DLKM','DKKM1000']::varchar[])" (point)</datasource>
      <layername>Beschriftungen (Rechtliche Festlegungen)</layername>
