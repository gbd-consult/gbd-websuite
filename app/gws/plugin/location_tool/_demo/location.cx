uid "location_tool"

title "Location tool"

metadata.keywords [ "client" ]

metadata.abstract """
Use browser geolocation to display the current position.
"""

client.addElements+ { tag "Toolbar.Location" }

map {
    crs 3857
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
}

{demo_osm_background}
