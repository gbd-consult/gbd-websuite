uid "auth_edit"

title "Editierrechte pro Layer und Rolle"

metadata.keywords [ "authentifizierung" "edit" "datenbank" ]

metadata.abstract """
Unterschiedliche Bearbeitungsrechte für zwei PostgreSQL Layer, abhängig von der Rolle des angemeldeten Nutzers.

Das Projekt ist für alle lesbar. Die Aktion `edit` und die Elemente `Sidebar.Edit` und `Toolbar.Edit` sind mit `access "allow user, deny all"` nur für angemeldete Nutzer freigegeben, so dass die Bearbeitungswerkzeuge erst nach der Anmeldung erscheinen.

Die Rechte werden pro Layer mit `permissions.edit` vergeben: der Layer "POIs" für die Rolle `groupA` (Logins `demo1`, `demo2`), der Layer "Districts" für die Rolle `groupB` (Logins `demo3`, `demo4`, `demo_mfa`). Das Passwort ist jeweils **demo**. `permissions.edit` setzt die Rechte zum Ändern, Anlegen und Löschen gemeinsam.
"""

map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}

actions+        { type "edit"         access "allow user, deny all" }
client.addElements+ { tag "Sidebar.Edit"  access "allow user, deny all" }
client.addElements+ { tag "Toolbar.Edit"  access "allow user, deny all" }

map.layers+ {
    title "POIs"
    type "postgres"
    tableName "edit.poi_small"
    permissions.edit "allow groupA, deny all"
}

map.layers+ {
    title "Districts"
    type "postgres"
    tableName "edit.district"
    permissions.edit "allow groupB, deny all"
}

{demo_osm_background}
