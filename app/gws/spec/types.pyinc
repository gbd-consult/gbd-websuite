class ApplicationManifestPlugin(Data):
    """Custom plugin entry in the application manifest."""

    path: DirPath
    """Path to the plugin directory; relative paths are resolved against the manifest location."""

    name: str = ''
    """Plugin name. When omitted, the directory name is used."""


class ApplicationManifest(Data):
    """Application manifest, read from a ``MANIFEST.json`` file.

    The manifest is JSON; lines starting with ``//`` or ``#`` are ignored.
    """

    excludePlugins: Optional[list[str]]
    """Names of the core plugins that should be deactivated."""
    plugins: Optional[list[ApplicationManifestPlugin]]
    """Custom plugins."""
    locales: list[str]
    """Locale names supported by this application."""
    tsConfig: list[str]
    """Path to ``tsconfig.json``."""
    withFallbackConfig: bool = False
    """Use a minimal fallback configuration."""
    withStrictConfig: bool = False
    """Stop the application upon a configuration error."""


class ExtObjectDescriptor(Data):
    """Extension object descriptor."""

    extName: str
    """Full extension name like ``gws.ext.object.layer.wms``."""
    extType: str
    """Extension type like ``wms``."""
    classPtr: type
    """Class object."""
    ident: str
    """Identifier."""
    modName: str
    """Name of the module that contains the class."""
    modPath: str
    """Path to the module that contains the class."""


class ExtCommandDescriptor(Data):
    """Command descriptor, describes the action method that handles a command."""

    extName: str
    """Full command name like ``gws.ext.command.api.mapGetBox``."""
    extType: str
    """Command name like ``mapGetBox``."""
    extCommandCategory: 'CommandCategory'
    """Command category."""
    methodName: str
    """Name of the action method that handles the command."""
    methodPtr: Callable
    """Command method. Not set by ``SpecRuntime.command_descriptor``."""
    request: 'Request'
    """Request sent to the command. Not set by ``SpecRuntime.command_descriptor``."""
    tArg: str
    """Type uid of the command argument (the request)."""
    tOwner: str
    """Type uid of the action class that owns the command."""
    owner: ExtObjectDescriptor
    """Object descriptor of the action class that owns the command."""


class SpecReadOption(Enum):
    """Options for reading values with ``SpecRuntime.read``."""

    acceptExtraProps = 'acceptExtraProps'
    """Accept extra object properties."""
    allowMissing = 'allowMissing'
    """Allow otherwise required properties to be missing."""
    caseInsensitive = 'caseInsensitive'
    """Case insensitive search for properties."""
    convertValues = 'convertValues'
    """Try to convert values to specified types."""
    ignoreExtraProps = 'ignoreExtraProps'
    """Silently ignore extra object properties."""
    verboseErrors = 'verboseErrors'
    """Add the value and the location of an error to ``ReadError`` exceptions."""


class CommandCategory(Enum):
    """Command category."""

    api = 'api'
    """API command."""
    cli = 'cli'
    """CLI command."""
    get = 'get'
    """Web GET command."""
    post = 'post'
    """Web POST command."""
    raw = 'raw'
    """Raw Web command without preprocessing."""


class SpecRuntime:
    """Spec runtime.

    Provides access to the generated specs: reading and validating values,
    looking up extension objects and commands, and loading classes.
    """

    version: str
    """Application version."""
    manifest: ApplicationManifest
    """Application manifest."""
    appBundlePaths: list[str]
    """Paths of the client bundles of all chunks."""

    def read(self, value, type_name: str, path: str = '', options: set[SpecReadOption] = None):
        """Read and validate a raw value according to a spec type.

        Args:
            value: Raw value from a config or a request.
            type_name: Type uid or extension name.
            path: Path of the config file, used to resolve relative paths and in error messages.
            options: Read options.

        Returns:
            The parsed value. Objects are returned as ``gws.Data``.

        Raises:
            ``gws.spec.core.ReadError``: If the value does not match the type.
        """

    def object_descriptor(self, type_name: str) -> Optional[ExtObjectDescriptor]:
        """Get an object descriptor.

        Args:
            type_name: Type uid or extension name.

        Returns:
            A descriptor or ``None`` if the type is not found.
        """

    def command_descriptor(self, command_category: CommandCategory, command_name: str) -> Optional[ExtCommandDescriptor]:
        """Get a command descriptor.

        Args:
            command_category: Command category.
            command_name: Command name.

        Returns:
            A descriptor or ``None`` if the command is not found.
        """

    def register_object(self, ext_name: ClassRef, obj_type: str, cls: type):
        """Register an extension class at run time.

        The class gets the ``extName`` and ``extType`` attributes.

        Args:
            ext_name: Extension category, like ``gws.ext.object.layer``.
            obj_type: Extension type, like ``wms``.
            cls: Class to register.

        Raises:
            ``gws.spec.core.Error``: If the class reference is invalid.
        """

    def get_class(self, classref: ClassRef, ext_type: Optional[str] = None) -> Optional[type]:
        """Get a class object for a class reference.

        The module defining the class is imported on demand.

        Args:
            classref: Class reference: a class, a class name or an extension name.
            ext_type: Extension type, used when ``classref`` is an extension category name.
                Defaults to ``default``.

        Returns:
            A class or ``None`` if the reference is not found.

        Raises:
            ``gws.spec.core.LoadError``: If the module cannot be imported.
        """

    def parse_classref(self, classref: ClassRef) -> tuple[Optional[type], str, str]:
        """Parse a class reference.

        Args:
            classref: Class reference.

        Returns:
            A tuple ``(class object, class name, extension name)``, where only one element is set.

        Raises:
            ``gws.spec.core.Error``: If the class reference is invalid.
        """

    def get_config_types(self, lang: str) -> list[dict]:
        """Get the configuration types as dictionaries.

        Docstrings, titles and enum docs are taken from the strings in the given language.

        Args:
            lang: Language code.

        Returns:
            A list of type dictionaries.
        """
