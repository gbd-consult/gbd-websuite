uid "edit_custom"

title "Editieren mit angepasstem Formular"

metadata.keywords [ "edit" "datenbank" ]

metadata.abstract """
Bearbeiten eines PostgreSQL Punktlayers mit einem selbst definierten Formular, das nur einen Teil der Tabellenspalten enthält.

Die Felder werden im Modell unter `fields` einzeln konfiguriert, jeweils mit `type`, `title` und einem `widget`: `input` für Text, `select` mit festen `items` für den Code, `date` für das Datum und `textarea` für die Kommentare. Der Primärschlüssel `id` ist mit `permissions.edit "deny all"` schreibgeschützt, `isRequired true` macht `name` zum Pflichtfeld.

Durch `textSearch` am Feld `name` erhält die Objektliste im Reiter "Editieren" ein Suchfeld. Die Vorlagen `feature.title` und `feature.label` bestimmen den Eintrag in der Objektliste und die Beschriftung auf der Karte.

Der Layer hat eine feste Ausdehnung (`extent`), damit neue Objekte auch außerhalb der aus den Daten berechneten Ausdehnung gezeichnet werden können.
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }


map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}


map.layers+ {
    title "Interessante Orte"
    type "postgres"
    tableName "edit.poi"
    extent [ 431881, 6505964, 1076161, 6877804 ]

    models+ {
        type "postgres"
        uid "model_poi_simple"
        sort+ { fieldName "name" }
        isEditable true
        permissions.edit "allow all"

        fields+ {
            name "id"
            type "integer"
            title "Identifier"
            isPrimaryKey true
            isRequired true
            permissions.edit "deny all"
            widget { type "input" }
        }

        fields+ {
            name "name"
            type "text"
            title "Object name"
            isRequired true
            widget { type "input" }
            textSearch { type "any" }
        }

        fields+ {
            name "code"
            type "integer"
            title "Feature Code"
            widget {
                type "select"
                items [
                    { value 0  text "unknown" }
                    { value 100  text "primary feature" }
                    { value 200  text "secondary feature" }
                    { value 300  text "tertiary feature" }
                ]
            }
        }

        fields+ {
            name "updated"
            type "date"
            title "Date updated"
            widget {
                type "date"
            }
        }

        fields+ {
            name "description"
            type "text"
            title "Comments"
            widget { type "textarea" height 150 placeholder "Enter your comments" }
        }

        fields+ {
            name "geom"
            type "geometry"
            title "Geometry"
        }

        templates+ {
            subject "feature.title"
            type "html"
            text "{{name}}"
        }

        templates+ {
            subject "feature.label"
            type "html"
            text "{{name}}"
        }
    }
}

{demo_osm_background}
