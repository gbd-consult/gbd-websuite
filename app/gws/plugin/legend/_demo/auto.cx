uid "legend_auto"

title "Automatische WMS Legende"

metadata.keywords [ "karte" "wms" ]

metadata.abstract """
Die Legende eines WMS Layers wird automatisch aus den Legendengrafiken des Dienstes erzeugt.

Im Seitenleisten-Reiter „Layer“ auf den Layer „NRW ALKIS WMS“ klicken; die Legende erscheint in den Layer-Details.

Der `wmsflat` Layer hat keine `legend` Konfiguration. Die WebSuite liest dann die Legenden-URLs der unter `sourceLayers.names` gewählten Quell-Layer aus den Capabilities des Dienstes und fügt die Bilder zu einer Legende zusammen. Für Layer aus QGIS Projekten wird die Legende ebenso automatisch erzeugt.
"""

map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 4000
}

map.layers+ {
    title "NRW ALKIS WMS"
    type "wmsflat"
    provider.url "https://www.wms.nrw.de/geobasis/wms_nw_alkis"
    sourceLayers.names [
        "adv_alkis_gewaesser"
        "adv_alkis_vegetation"
        "adv_alkis_bodensch"
    ]
    metadata.attribution "&copy; <a href='http://www.geobasis.nrw.de'>Geobasis NRW</a>"
}

{demo_osm_background}
