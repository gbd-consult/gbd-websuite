uid "gbd_geoservices"

title "GBD Geoservices: Karten und Suche"

metadata.keywords [ "suche" "karte" ]

metadata.abstract """
Hintergrundkarten und Volltextsuche aus den [GBD Geoservices](https://geoservices.gbd-consult.de) für ganz Deutschland.

Im Seitenleisten-Reiter „Layer“ eine der Karten der Gruppe „Karten“ wählen; es ist immer nur eine sichtbar. Die Karten gibt es in vier Farbschemata (Standard, Hell, Dunkel, Kontrast) mit je drei Detailstufen (normal, Minimal, Alles). Im Suchfeld in der oberen Leiste oder im Reiter „Suche“ nach Orten, Straßen, Adressen und Punkten von Interesse suchen.

Die Karten sind `tile` Layer mit `display "client"`, die Kacheln also direkt vom Dienst laden; sie werden über das Makro `@def TILES` erzeugt. Die Gruppe hat `clientOptions {{ expanded true exclusive true }}`. Für die Suche wird ein Finder vom Typ `gbd_geoservices` mit `apiKey` und `spatialContext "map"` konfiguriert.
"""

client.addElements+ { tag "Sidebar.Search" }
client.addElements+ { tag "Altbar.Search" }

actions+ { type "search" tolerance "5px" }

finders+ {
    type "gbd_geoservices"
    apiKey "gwsdemo"
    spatialContext "map"
}

map {
    center [1163289, 6649645]
    extent [612257, 5942074, 1725452, 7420309]
    zoom.initScale 5000000
    zoom.maxScale 5000000
    zoom.minScale  50
}


@def TILES(theme, titel, visible=False)
    layers+ {
        title "{titel}"
        type "tile"
        display "client"
        clientOptions.hidden {not visible} 
        provider.url "https://geoservices.gbd-consult.de/xyz/{theme}/{{z}}/{{x}}/{{y}}.png?key=gwsdemo"
        metadata.attribution "© <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"
    }
@end

map.layers+ {
    title "Karten"
    type "group"
    clientOptions { expanded true exclusive true }

    @TILES("std", "Standard", visible=True)
    @TILES("min", "Standard (Minimal)")
    @TILES("max", "Standard (Alles)")
    
    @TILES("light", "Hell")
    @TILES("light_min", "Hell (Minimal)")
    @TILES("light_max", "Hell (Alles)")
    
    @TILES("dark", "Dunkel")
    @TILES("dark_min", "Dunkel (Minimal)")
    @TILES("dark_max", "Dunkel (Alles)")
    
    @TILES("hico", "Kontrast")
    @TILES("hico_min", "Kontrast (Minimal)")
    @TILES("hico_max", "Kontrast (Alles)")

}

