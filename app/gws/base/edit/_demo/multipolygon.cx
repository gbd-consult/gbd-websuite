uid "edit_multipolygon"

title "Editieren von MultiPolygon-Geometrien"

metadata.keywords [ "edit" "datenbank" "vektordaten" ]

metadata.abstract """
Bearbeiten von Wasserflächen aus einer PostgreSQL Tabelle, deren Geometriespalte den Typ MultiPolygon hat.

Im Reiter "Editieren" den Layer "Wasser" wählen. Zum Zeichnen neuer Objekte bietet der Client für MultiPolygon-Geometrien dieselben Formen an wie für Polygone: Polygon, Kreis und Rechteck.

Das Modell hat keine `fields`; Formular und Geometrietyp werden aus der Tabelle `edit.water` abgeleitet. Die Vorlagen `feature.title` und `feature.label` vom Typ `text` zeigen den Namen in der Liste und auf der Karte.
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }


map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}

map.layers+ {
    title "Wasser"
    type "postgres"
    tableName "edit.water"
    cssSelector ".edit_wasser"
    models+ {
        type "postgres"
        isEditable true
        permissions.edit 'allow all'
    }
    templates+ {
        subject "feature.title"
        type "text"
        text "{{name}}"
    }
    templates+ {
        subject "feature.label"
        type "text"
        text "{{name}}"
    }
}

{demo_osm_background}
