class TemplateArgs(Data):
    """Template arguments."""

    app: 'Application'
    """Application object."""
    locale: 'Locale'
    """Current locale."""
    date: 'DateFormatter'
    """Locale-aware date formatter."""
    time: 'TimeFormatter'
    """Locale-aware time formatter."""
    number: 'NumberFormatter'
    """Locale-aware number formatter."""


class TemplateRenderInput(Data):
    """Template render input."""

    args: dict | Data
    """Template arguments."""
    crs: 'Crs'
    """CRS for maps."""
    dpi: int
    """Output resolution in dots per inch."""
    locale: 'Locale'
    """Locale for the output."""
    maps: list[MapRenderInput]
    """Maps to render, for print templates."""
    mimeOut: str
    """Requested output MIME type."""
    notify: Callable
    """Callback for progress messages."""
    project: 'Project'
    """Current project."""
    user: 'User'
    """Current user."""


class TemplateQualityLevel(Config):
    """Print quality level users can choose."""

    name: str
    """Quality level name shown to users."""
    dpi: int
    """Print resolution in dots per inch."""


class Template(Node):
    """Template, generates content from data."""

    mapSize: UomSize
    """Default map size for the template."""
    mimeTypes: list[str]
    """MIME types the template can generate."""
    pageSize: UomSize
    """Default page size for printing."""
    pageMargin: UomExtent
    """Default page margin for printing."""
    subject: str
    """Template subject, the purpose the template serves, like ``feature.description``."""
    title: str
    """Template title."""

    def render(self, tri: TemplateRenderInput) -> ContentResponse:
        """Render the template.

        Args:
            tri: Render input.

        Returns:
            A response with the generated content.
        """


class TemplateManager(Node):
    """Template manager, finds templates by subject and creates them from files."""

    def find_templates(self, subjects: list[str], where: list[Node], user: 'User' = None, mime_type: str = None) -> list['Template']:
        """Find templates for several subjects.

        Args:
            subjects: Template subjects.
            where: Objects whose templates are searched, in this order.
            user: If given, only templates this user can use.
            mime_type: If given, only templates which can produce this MIME type.

        Returns:
            Found templates, one per subject at most.
        """

    def find_template(self, subject: str, where: list[Node], user: 'User' = None, mime_type: str = None) -> Optional['Template']:
        """Find a template for a subject.

        The templates of the objects in ``where`` are searched in the given order,
        then the application templates. A template without ``mimeTypes`` matches any
        MIME type.

        Args:
            subject: Template subject.
            where: Objects whose templates are searched, in this order.
            user: If given, only templates this user can use.
            mime_type: If given, only templates which can produce this MIME type.

        Returns:
            The first matching template, or ``None``.
        """

    def template_from_path(self, path: str) -> Optional['Template']:
        """Create a template from a file.

        The template type is derived from the file extension.

        Args:
            path: File path.

        Returns:
            A template, or ``None`` if the file is not a template.
        """
