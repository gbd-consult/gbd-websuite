uid "edit_lazy"

title "Editieren mit Laden nach Suchbegriff"

metadata.keywords [ "edit" "suche" "datenbank" ]

metadata.abstract """
Bearbeiten eines PostgreSQL Punktlayers, bei dem Objekte erst nach Eingabe eines Suchbegriffs geladen werden. Geeignet für große Tabellen.

Im Reiter "Editieren" den Layer "Interessante Orte" wählen und in das Suchfeld einen Namen oder Namensteil eingeben. Die Liste zeigt dann nur die passenden Objekte.

Konfiguriert wird das mit `loadingStrategy "lazy"` am Layer. Durchsucht werden die Felder mit `textSearch`, hier `name` mit `type "any"` (Treffer an beliebiger Stelle im Text).
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }


map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 4000
    zoom.maxScale  1000000
    zoom.minScale  100
}

map.layers+ {
    title "Interessante Orte"
    type "postgres"
    tableName "edit.poi"
    loadingStrategy "lazy"
    cssSelector ".custom_poi"

    models+ {
        type "postgres"
        isEditable true
        permissions.edit 'allow all'
        sort+ { fieldName "name" }

        fields+ {
            name "id"
            type "integer"
            title "Identifier"
            isPrimaryKey true
            isRequired true
            permissions.edit "deny all"
            widget { type "input" }
        }

        fields+ {
            name "name"
            type "text"
            title "Object name"
            isRequired true
            widget { type "input" }
            textSearch { type "any" }
        }
    }

    templates+ { subject "feature.label" type "html" text "{{name}}" }
    templates+ { subject "feature.title" type "html" text "{{name}}" }
}

{demo_osm_background}
