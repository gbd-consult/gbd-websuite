@# mockmap example configuration
@#
@# jump templating is applied before slon parsing, so values can be computed.
@# note: "{" must be followed by whitespace, otherwise it starts an echo.

@let crs32 = 25832
@let crsWM = 3857
@let crsSA = 31983

default {
    layer "map"
    overlay false
    overlayTile true
    probe true

    extent [ -25 34 45 72 ]
    step 1.0
    graticule true
    checker true
    shapes true
    labels true
    labelSize 9
    labelPad 0
    labelPartials false
    labelForce false
    background ""
}

@# 6. WMS

services+ {
    uid "wms_32"
    type "wms"
    version "1.3.0"
    crs {crs32}
}

services+ {
    uid "wms_84"
    type "wms"
    version "1.3.0"
    crs 4326
}

services+ {
    uid "wms_84_111"
    type "wms"
    version "1.1.1"
    crs 4326
}

@# a projection with nothing in common with the others: southern hemisphere,
@# 10000000 false northing, and an area of use on another continent

services+ {
    uid "wms_sa"
    type "wms"
    version "1.3.0"
    crs {crsSA}
}

@# 3. WMTS KVP

services+ {
    uid "wmts_32"
    type "wmts"
    crs {crs32}
}

@# 4. WMTS RESTful

services+ {
    uid "wmtsr_32"
    type "wmts_rest"
    crs {crs32}
}

@# 1. XYZ

services+ {
    uid "xyz_3857"
    type "xyz"
    crs {crsWM}
}

@# 2. TMS - disabled: the GWS tile provider is XYZ-only and renders a
@# sw-origin source mirrored. See grabber spec 12.2.
@#
@# services+ {
@#     uid "tms_3857"
@#     type "tms"
@#     crs {crsWM}
@# }
