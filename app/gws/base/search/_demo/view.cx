uid "search_view"

title "Suche im aktuellen Kartenausschnitt"

metadata.keywords [ "suche" "datenbank" ]

metadata.abstract """
Textsuche, die nur Objekte im aktuell sichtbaren Kartenausschnitt findet.

Im Seitenleisten-Reiter „Suche“ mindestens drei Zeichen eines Namens eingeben. Es werden nur Treffer im sichtbaren Kartenausschnitt geliefert; nach dem Verschieben oder Zoomen der Karte ändert sich die Trefferliste bei erneuter Suche.

Der Finder vom Typ `postgres` durchsucht die Tabelle `edit.poi`. Mit `spatialContext "view"` wird eine Stichwortsuche ohne Suchgeometrie auf den Kartenausschnitt beschränkt; der Standardwert `map` durchsucht die gesamte Kartenausdehnung. Die Trefferliste zeigt den Namen über eine Vorlage mit `subject "feature.title"`.
"""

client.addElements+ { tag "Sidebar.Search" }


actions+ { type "search" }

finders+ {
    type "postgres"
    tableName "edit.poi"

    spatialContext "view"

    models+ {
        type "postgres"
        sort+ { fieldName "name" }

        fields+ {
            name "id"
            type "integer"
            isPrimaryKey true
        }
        fields+ {
            name "name"
            type "text"
            textSearch { type "any" minLength 3 }
        }
        fields+ {
            name "geom"
            type "geometry"
        }
    }

    templates+ {
        type "html"
        subject "feature.title"
        text "{{name}}"
    }
}

map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 30000
    zoom.maxScale  1000000
}

{demo_osm_background}
