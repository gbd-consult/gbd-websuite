uid "alkis_mini"

title "ALKIS Flurstückssuche, minimal"

metadata.keywords [ "alkis" "suche" ]

metadata.abstract """
ALKIS Flurstückssuche mit minimaler Konfiguration.

Im Seitenleisten-Reiter der Flurstückssuche nach Gemarkung, Straße und Hausnummer oder Flurstückskennzeichen suchen. Die Suche kann auch über URL-Parameter gestartet werden, der Treffer wird dann auf der Karte markiert:

- [Hausnummer-Suche](/project/alkis_mini?alkisAd=Unnaer%20Straße_50) mit `alkisAd`
- [Flurstückssuche](/project/alkis_mini?alkisFs=05_051409_0_183_115) mit `alkisFs`

Die Aktion `alkis` benötigt nur die Datenbankanbindung: `dbUid`, `dataSchema` (Schema der ALKIS-Daten), `indexSchema` (Schema des Suchindex) und `crs`. Im Client wird das Element `Sidebar.Alkis` hinzugefügt. Die Flurstücksgrenzen kommen aus dem ALKIS WMS von Geobasis NRW.
"""

actions+ {
    type "alkis"
    dbUid "DB_ALKIS"
    dataSchema "public"
    indexSchema "gws82"
    crs 25832
}

client.addElements+ { tag "Sidebar.Alkis" }
client.options.sidebarWidth 400

map {
    center {demo_point_kamen_25832}
    crs 25832
    zoom.initScale 250000
    zoom.maxScale  1000000
}

map.layers+ {
    title "NRW ALKIS"
    type "wmsflat"
    provider.url "https://www.wms.nrw.de/geobasis/wms_nw_alkis"
    sourceLayers.names [ "adv_alkis_flurstuecke" ]
    metadata.attribution "&copy; <a href='http://www.geobasis.nrw.de'>Geobasis NRW</a>"
}

{demo_osm_background}
