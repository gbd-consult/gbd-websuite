uid "tile_layer_server"

title "Kachellayer mit Server-Cache"

metadata.keywords [ "karte" "rasterdaten" ]

metadata.abstract """
Ein XYZ-Kacheldienst (OpenStreetMap), dessen Kacheln über den Server ausgeliefert und dort zwischengespeichert werden.

Der Layer hat `type "tile"`, die Kachel-URL wird mit `provider.url` und den Platzhaltern `{{x}}`, `{{y}}`, `{{z}}` angegeben. Mit `display "tile"` ruft der Browser die Kacheln von der WebSuite ab, nicht direkt vom Dienst; `withCache true` speichert sie auf dem Server.
"""

map {
    crs 3857
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
}

map.layers+ {
    title "Open Street Map"
    type "tile"
    provider.url "https://geoservices.gbd-consult.de/xyz/max/{{z}}/{{x}}/{{y}}.png"
    display "tile"
    withCache true
}
