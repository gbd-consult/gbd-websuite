class MiddlewareManager(Node):
    """Middleware manager.

    Middleware objects process every web request: the web server calls
    ``enter_middleware`` on each of them in dependency order before the action,
    and ``exit_middleware`` in reverse order after it.
    """

    def register(self, obj: Node, name: str, depends_on: Optional[list[str]] = None):
        """Register an object as a middleware.

        Args:
            obj: The middleware object.
            name: Middleware name, for example ``db`` or ``auth``.
            depends_on: Names of middleware that must run before this one.
        """

    def objects(self) -> list[Node]:
        """Return the registered middleware objects in dependency order.

        Returns:
            A list of middleware objects, dependencies first.

        Raises:
            Error: If the dependencies are cyclic or refer to an unknown name.
        """


class TemplateOptions(Data):
    """Options for the built-in application and project home pages."""

    withLogin: bool = True
    """Show the login form on the home page."""
    footerText: Optional[str]
    """HTML text for the home page footer."""
    withGws: bool = True
    """Show the GWS logo in the home page footer."""
    homeResources: Optional[list[str]]
    """Extra resource URLs for the home page."""
    projectResources: Optional[list[str]]
    """Extra resource URLs for the project page."""


class Application(Node):
    """Application object.

    The top-level node of the configuration tree. It holds the managers, the
    global objects and the projects, and is available as ``root.app``.
    """

    client: 'Client'
    """Default client, used by projects without their own client configuration."""

    localeUids: list[str]
    """Default locale uids for all projects."""

    metadata: 'Metadata'
    """Application metadata."""

    monitor: 'ServerMonitor'
    """Server monitor, watches configuration files and runs periodic tasks."""

    templateOptions: TemplateOptions
    """Options for the built-in home page templates."""

    title: str
    """Application title."""

    vars: dict
    """Custom variables from the configuration."""

    version: str
    """Application version, for example ``8.5.3``."""

    versionString: str
    """Version string for display, with the revision if known."""

    def supported_crs(self) -> list['Crs']:
        """Return all CRS supported by the application.

        These are the CRS of all maps and the CRS supported by OWS services,
        plus the registered ones. The list is computed on the first call.

        Returns:
            A list of CRS objects, sorted by srid.
        """

    def register_supported_crs(self, crs: 'Crs'):
        """Register an additional supported CRS.

        Must be called during configuration.

        Args:
            crs: The CRS object.
        """

    defaultPrinter: 'Printer'
    """Default printer, used when no printer is configured."""

    actionMgr: 'ActionManager'
    """Action manager."""

    authMgr: 'AuthManager'
    """Authorization manager."""

    databaseMgr: 'DatabaseManager'
    """Database manager."""

    exporterMgr: 'ExporterManager'
    """Exporter manager."""

    jobMgr: 'JobManager'
    """Job manager."""

    middlewareMgr: 'MiddlewareManager'
    """Middleware manager."""

    modelMgr: 'ModelManager'
    """Model manager."""

    printerMgr: 'PrinterManager'
    """Printer manager."""

    searchMgr: 'SearchManager'
    """Search manager."""

    serverMgr: 'ServerManager'
    """Server manager."""

    storageMgr: 'StorageManager'
    """Storage manager."""

    templateMgr: 'TemplateManager'
    """Template manager."""

    webMgr: 'WebManager'
    """Web manager."""

    actions: list['Action']
    """Actions available in all projects."""

    projects: list['Project']
    """Configured projects."""

    exporters: list['Exporter']
    """Global exporters."""

    finders: list['Finder']
    """Finders available in all projects."""

    templates: list['Template']
    """Global templates, including the built-in ones."""

    printers: list['Printer']
    """Global printers."""

    models: list['Model']
    """Global models."""

    owsServices: list['OwsService']
    """OWS services provided by the server."""

    def project(self, uid: str) -> Optional['Project']:
        """Find a project by its uid.

        Args:
            uid: Project uid.

        Returns:
            The project, or ``None`` if not found.
        """

    def helper(self, ext_type: str) -> Optional['Node']:
        """Return a helper object by its type.

        A helper that is not configured is created with default options on the first call.

        Args:
            ext_type: Helper type, for example ``upload``.

        Returns:
            The helper object.

        Raises:
            Error: If the helper type does not exist.
        """

    def developer_option(self, key: str):
        """Return the value of a developer option.

        Developer options are configured in the ``developer`` property of the
        application config and are meant for development and debugging only.

        Args:
            key: Option name, for example ``template.always_reload``.

        Returns:
            The option value, or ``None`` if it is not set.
        """
