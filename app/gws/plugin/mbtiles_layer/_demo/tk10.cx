uid "mbtiles_layer"

title "MBTiles Layer mit Transparenz"

metadata.keywords [ "rasterdaten" "karte" ]

metadata.abstract """
Ein Rasterlayer aus einer MBTiles-Datei (Topographische Karte 1:10.000), dessen weißer Hintergrund transparent dargestellt wird, so dass die OSM-Karte darunter sichtbar bleibt.

Der Layer hat `type "mbtiles"`, die Datei wird mit `provider.path` angegeben, mit `display "tile"` wird er gekachelt über den Server ausgeliefert.

Die Transparenz wird mit zwei Optionen erreicht:

- `transparentColor '#ffffff'` behandelt reines Weiß als transparent,
- die MapServer-Direktive `SCALE=0,240` in `processing` zieht nahezu weiße Farbwerte auf Weiß, damit auch diese transparent werden.
"""

map {
    crs 3857
    zoom.initScale 200000
    extent {demo_make_extent(1579358, 6615879, 4000)}
}


map.layers+ {
    type "mbtiles"
    title "TK-10"
    display "tile"
    provider.path "/gws-extern/demos/mbtiles/TK10_SN.mbtiles"
    @# Set white as transparent color
    transparentColor '#ffffff'
    @# Use the SCALE processing to map 'almost white' colors to white
    processing [
        "SCALE=0,240"
    ]
}

{demo_osm_background}
