uid "field_related_feature_list"

title "Editieren 1:N-Beziehung als Feature-Liste"

metadata.keywords [ "edit" "datenbank" ]

metadata.abstract """
Zu einer Kategorie die zugehörigen POIs als Liste im Formular anzeigen und bearbeiten.

Im Reiter "Editieren" das Modell "Categories" wählen und eine Kategorie öffnen. Das Feld "POIs" listet alle POIs dieser Kategorie; über die Schaltflächen der Liste werden POIs neu angelegt, verknüpft oder geöffnet.

Das Feld ist vom Typ `relatedFeatureList`: `toModel` verweist auf das POI-Modell, `toColumn "category_id"` ist die Fremdschlüsselspalte in dessen Tabelle und `fromColumn "id"` der Schlüssel der Kategorie. Das Widget `featureList` zeigt die Kindobjekte als Liste; per Vorgabe sind `withNewButton`, `withLinkButton` und `withEditButton` aktiv, `withUnlinkButton` nicht.

Das POI-Modell hat hier kein Feld für die Kategorie. Beide Richtungen zeigt die Demo [Editieren 1:N-Beziehung in beide Richtungen](/project/field_related_feature_list_2).
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }


map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}

models+ {
    type "postgres"
    uid "model_poi_001"
    tableName "edit.poi_small"
    sort+ { fieldName "name" }
    title "POIs"
    isEditable true
    permissions.edit "allow all"

    fields+ { name "id" type "integer" title "Identifier" isPrimaryKey true permissions.edit "deny all" }
    fields+ { name "name" type "text" title "Name" isRequired true textSearch { type "any" } }
    fields+ { name "geom" type "geometry" title "Geometry" isRequired true }

    templates+ {
        subject "feature.title"
        type "html"
        text "{{@if feature.isNew}} Unbenannt {{@else}} {{name}} {{@end}}"
    }
}

models+ {
    type "postgres"
    uid "model_category_001"
    tableName "edit.category"
    title "Categories"
    sort+ { fieldName "name_de" }
    isEditable true
    permissions.edit "allow all"

    fields+ { name "id" type "integer" title "Identifier" isPrimaryKey true permissions.edit "deny all" }
    fields+ { name "name_de" type "text" title "Name (DE)" isRequired true textSearch { type "any" } }
    fields+ { name "name_en" type "text" title "Name (EN)" isRequired true textSearch { type "any" } }

    fields+ {
        name "pois"
        title "POIs"
        type "relatedFeatureList"
        fromColumn "id"
        toModel "model_poi_001"
        toColumn "category_id"
        widget.type "featureList"
    }

    templates+ { subject "feature.title" type "html" text "{{name_de}}" }
}

{demo_osm_background}
