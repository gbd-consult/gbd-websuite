uid "raster_layer_dir"

title "Rasterlayer aus Bildverzeichnis"

metadata.keywords [ "rasterdaten" "karte" ]

metadata.abstract """
Ein Rasterlayer aus mehreren georeferenzierten Bilddateien: digitale Orthophotos (DOP) von Geobasis NRW im JPEG-2000-Format.

Der Layer hat `type "raster"`. Statt einzelner Dateien in `provider.paths` erfasst `provider.pathPattern` alle Dateien, die auf das Muster `*.jp2` passen; die Bilder werden zu einem Layer zusammengesetzt. Mit `display "tile"` wird der Layer gekachelt über den Server ausgeliefert.

Die Karte ist mit `crs 25832` konfiguriert. Die Quellenangabe kommt aus `metadata.attribution`.
"""

map {
    crs 25832
    zoom.initScale 35000
    extent {demo_make_extent(341390, 5673090, 4000)}
}


@# https://www.opengeodata.nrw.de/produkte/geobasis/lusat/akt/dop/dop_jp2_f10/

map.layers+ {
    type "raster"
    title "DOP"
    display "tile"
    provider.pathPattern "/gws-extern/demos/dop/*.jp2"
    metadata.attribution "© Geobasis NRW"
}

{demo_osm_background}
