uid "select_export"

title "Feature-Auswahl mit Export"

metadata.keywords [ "werkzeuge" "vektordaten" "qgis" ]

metadata.abstract """
Features mit dem Auswahlwerkzeug auswählen und in verschiedenen Dateiformaten exportieren.

In der Werkzeugleiste "Auswählen" aktivieren und Objekte anklicken, oder mit "Auswahl mithilfe eines Polygons" eine Fläche zeichnen. Die ausgewählten Features erscheinen im Reiter "Auswahl" der Seitenleiste. Mit der Export-Schaltfläche unten im Reiter ein Format wählen und den Export starten; die Datei wird heruntergeladen.

Die Aktion `exporter` stellt den Export bereit, die Formate werden unter `exporters` konfiguriert: `shapefile`, `kml`, `gml` und `geojson`, jeweils mit `target "download"`. Der zweite GML-Exporter schreibt mit `withMultiLayer true` alle Layer in eine gemeinsame Datei.

Die Layer sind `qgisflat`-Layer aus einem QGIS-Projekt. Die Features für die Auswahl liefern die `finders` vom Typ `postgres`, die auf die zugehörigen Tabellen zugreifen. Mit `storage` an der Aktion `select` kann eine Auswahl außerdem gespeichert und wieder geladen werden.
"""

client.addElements+ { tag "Sidebar.Select" }
client.addElements+ { tag "Toolbar.Select" }
client.addElements+ { tag "Toolbar.Select.Draw" }
client.addElements+ { tag "Task.Select" }

actions+ {
    type "exporter"
}

actions+ {
    type "select"
    storage {
        permissions {
            read "allow all"
            write "allow all"
            create "allow all"
        }
    }
}

exporters+ {
    uid "shapefile_exporter"
    type "shapefile"
    title "Shapefile"
    target "download"
    access "allow all"
}

exporters+ {
    uid "kml_exporter"
    type "kml"
    title "KML"
    target "download"
    access "allow all"
}

exporters+ {
    uid "gml_exporter"
    type "gml"
    title "GML"
    target "download"
    access "allow all"
}
    
exporters+ {
    uid "gml_multi_exporter"
    type "gml"
    title "GML (alle Layer in einer Datei)"
    target "download"
    access "allow all"
    withMultiLayer true
}

exporters+ {
    uid "geojson_exporter"
    type "geojson"
    title "GeoJSON"
    target "download"
    access "allow all"
}

map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 30000
    zoom.maxScale  1000000
    zoom.minScale  1000
}

map.layers+ {
    title "Interessante Orte"
    type "qgisflat"
    provider.path "/demos/search_multi.qgs"
    sourceLayers.names [ "Interessante Orte" ]
    finders+ {
        type "postgres"
        tableName "edit.poi"
    }
    templates+ {
        type "html"
        subject "feature.title"
        text "{{name}}"
    }
}

map.layers+ {
    title "Parks"
    type "qgisflat"
    provider.path "/demos/search_multi.qgs"
    sourceLayers.names [ "Parks" ]
    finders+ {
        type "postgres"
        tableName "edit.park"
    }
    templates+ {
        type "html"
        subject "feature.title"
        text "{{name}}"
    }
}

map.layers+ {
    title "Wasserflächen"
    type "qgisflat"
    provider.path "/demos/search_multi.qgs"
    sourceLayers.names [ "Wasserflächen" ]
    finders+ {
        type "postgres"
        tableName "edit.water"
    }
    templates+ {
        type "html"
        subject "feature.title"
        text "{{name}}"
    }
}
 
{demo_osm_background}
