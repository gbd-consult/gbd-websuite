class DatabaseModel(Model):
    """Data model for a database table."""

    db: 'DatabaseProvider'
    """Database provider."""
    sqlFilter: str
    """Literal SQL condition applied when selecting rows."""
    tableName: str
    """Table name associated with this model."""

    def table(self) -> 'sqlalchemy.Table':
        """Return the SQLAlchemy ``Table`` object of the model table.

        Returns:
            The table object.

        Raises:
            ``sqlalchemy.exc.SQLAlchemyError``: If the table does not exist.
        """

    def column(self, column_name: str) -> 'sqlalchemy.Column':
        """Return the SQLAlchemy ``Column`` object of a column in the model table.

        Args:
            column_name: Column name.

        Returns:
            The column object.

        Raises:
            ``sqlalchemy.exc.SQLAlchemyError``: If the table or the column does not exist.
        """

    def uid_column(self) -> 'sqlalchemy.Column':
        """Return the SQLAlchemy ``Column`` object of the primary key column.

        Returns:
            The column object for ``uidName``.

        Raises:
            ``gws.Error``: If the model has no primary key or the key column does not exist.
        """

    def fetch_features(self, select: 'sqlalchemy.Select') -> list['Feature']:
        """Run a SELECT statement and create a feature for each row.

        The row values become the attributes of the feature record.

        Args:
            select: SELECT statement.

        Returns:
            A list of features.
        """

    def build_select(self, mc: 'ModelContext') -> Optional['sqlalchemy.Select']:
        """Build a SELECT statement for a search.

        Combines the search query in ``mc.search``, the columns and conditions
        collected by the fields in ``mc.dbSelect`` and ``sqlFilter``.

        Args:
            mc: Model context with ``search`` and ``dbSelect`` set.

        Returns:
            The SELECT statement, or ``None`` if the search cannot match anything.
        """


class ColumnDescription(Data):
    """Description of a dataset column."""

    columnIndex: int
    """The index of the column within the table."""
    comment: str
    """Column comment or description provided in the database metadata."""
    default: str
    """The default value assigned to the column, if any."""
    geometrySrid: int
    """The Spatial Reference Identifier (SRID) for geometry columns."""
    geometryType: GeometryType
    """The type of geometry stored in the column (e.g., Point, Polygon)."""
    isAutoincrement: bool
    """Indicates if the column is auto-incremented."""
    isNullable: bool
    """Specifies if the column permits NULL values."""
    isPrimaryKey: bool
    """Specifies if the column is part of the primary key."""
    isUnique: bool
    """Indicates if the column has a unique constraint."""
    hasDefault: bool
    """Indicates if the column has a database-defined default value."""
    isIndexed: bool
    """Indicates if the column has an index."""
    name: str
    """The name of the column."""
    nativeType: str
    """The database-specific data type of the column."""
    options: dict
    """Additional options or configurations for the column, if any."""
    type: AttributeType
    """The abstract type of the column used in higher-level processing."""


class DataSetDescription(Data):
    """Description of a dataset, like a DB table or a GDAL data set."""

    columns: list[ColumnDescription]
    """A list of column descriptions."""
    columnMap: dict[str, ColumnDescription]
    """A dictionary mapping column names to their descriptions."""
    fullName: str
    """The full name of the dataset, including schema if applicable."""
    geometryName: str
    """The name of the geometry column, if any."""
    geometrySrid: int
    """The Spatial Reference Identifier (SRID) for the geometry."""
    geometryType: GeometryType
    """The type of geometry stored in the dataset."""
    name: str
    """The name of the dataset or table."""
    schema: str
    """The schema to which the dataset belongs."""


class DatabaseManager(Node):
    """Database manager."""

    providers: list['DatabaseProvider']
    """A list of database providers managed by this DatabaseManager."""

    def create_provider(self, cfg: Config, **kwargs) -> 'DatabaseProvider':
        """Create a database provider and add it to ``providers``.

        The provider is created as a shared object. A provider with the same uid
        that is already in ``providers`` is replaced.

        Args:
            cfg: Provider configuration.
            **kwargs: Extra configuration values.

        Returns:
            The provider.
        """

    def find_provider(self, uid: Optional[str] = None, ext_type: Optional[str] = None) -> Optional['DatabaseProvider']:
        """Find a database provider by uid or type.

        With ``uid``, returns the provider with this uid (and of type ``ext_type``,
        if given). With ``ext_type`` only, returns the first provider of this type.
        Without arguments, returns the first provider.

        Args:
            uid: Provider uid.
            ext_type: Provider type, e.g. ``postgres``.

        Returns:
            The provider, or ``None`` if none matches.
        """


DatabaseTableAlike: TypeAlias = Union['sqlalchemy.Table', str]
"""An SQLAlchemy ``Table`` object or a string table name."""


DatabaseStmt: TypeAlias = Union['sqlalchemy.Executable', str]
"""An Executable SQLAlchemy object or a string SQL statement."""


class DatabaseConnection:
    """Database connection.

    Wraps an SQLAlchemy ``Connection`` and provides some convenience methods.
    Returned by ``DatabaseProvider.connect`` and used as a context manager,
    which closes the connection on exit.

    Statements can be SQLAlchemy objects or SQL strings with ``:name`` bind
    parameters. The ``fetch_*`` methods roll back the transaction after reading.
    """

    saConn: 'sqlalchemy.Connection'
    """The underlying SQLAlchemy connection."""

    def __enter__(self) -> 'DatabaseConnection': ...

    def __exit__(self, exc_type, exc_value, traceback): ...

    def execute(self, stmt: 'sqlalchemy.Executable', params=None, execution_options: dict=None) -> 'sqlalchemy.CursorResult':
        """Execute an SQLAlchemy statement.

        Args:
            stmt: Statement.
            params: Bind parameters, a dict or a list of dicts.
            execution_options: SQLAlchemy execution options.

        Returns:
            The result.
        """

    def commit(self):
        """Commit the current transaction."""

    def rollback(self):
        """Roll back the current transaction."""

    def close(self):
        """Close the connection.

        The connection is shared by nested ``connect`` calls, and only the
        outermost ``close`` closes the SQLAlchemy connection.
        """

    def exec(self, stmt: 'DatabaseStmt', **params) -> 'sqlalchemy.CursorResult':
        """Execute a statement.

        Args:
            stmt: Statement or SQL string.
            **params: Bind parameters.

        Returns:
            The result.
        """

    def exec_commit(self, stmt: 'DatabaseStmt', **params) -> 'sqlalchemy.CursorResult':
        """Execute a statement and commit, or roll back on error.

        Args:
            stmt: Statement or SQL string.
            **params: Bind parameters.

        Returns:
            The result.

        Raises:
            ``Exception``: Any error from the execution is re-raised after the rollback.
        """

    def exec_rollback(self, stmt: 'DatabaseStmt', **params) -> 'sqlalchemy.CursorResult':
        """Execute a statement and roll back afterwards.

        Args:
            stmt: Statement or SQL string.
            **params: Bind parameters.

        Returns:
            The result.
        """

    def fetch_all(self, stmt: 'DatabaseStmt', **params) -> list[dict]:
        """Execute a statement and return all rows.

        Args:
            stmt: Statement or SQL string.
            **params: Bind parameters.

        Returns:
            A list of rows as dicts.
        """

    def fetch_first(self, stmt: 'DatabaseStmt', **params) -> dict | None:
        """Execute a statement and return the first row.

        Args:
            stmt: Statement or SQL string.
            **params: Bind parameters.

        Returns:
            The first row as a dict, or ``None`` if there are no rows.
        """

    def fetch_scalars(self, stmt: 'DatabaseStmt', **params) -> list:
        """Execute a statement and return the first column of all rows.

        Args:
            stmt: Statement or SQL string.
            **params: Bind parameters.

        Returns:
            A list of values.
        """

    def fetch_strings(self, stmt: 'DatabaseStmt', **params) -> list[str]:
        """Execute a statement and return the first column of all rows as strings.

        Args:
            stmt: Statement or SQL string.
            **params: Bind parameters.

        Returns:
            A list of strings, with ``NULL`` values as empty strings.
        """

    def fetch_ints(self, stmt: 'DatabaseStmt', **params) -> list[int]:
        """Execute a statement and return the first column of all rows as integers.

        Args:
            stmt: Statement or SQL string.
            **params: Bind parameters.

        Returns:
            A list of integers.

        Raises:
            ``ValueError``: If a value is not an integer.
        """

    def fetch_scalar(self, stmt: 'DatabaseStmt', **params) -> Any:
        """Execute a statement and return the first column of the first row.

        Args:
            stmt: Statement or SQL string.
            **params: Bind parameters.

        Returns:
            The value, or ``None`` if there are no rows.
        """

    def fetch_string(self, stmt: 'DatabaseStmt', **params) -> str | None:
        """Execute a statement and return the first column of the first row as a string.

        Args:
            stmt: Statement or SQL string.
            **params: Bind parameters.

        Returns:
            The string, or ``None`` if there are no rows or the value is ``NULL``.
        """

    def fetch_int(self, stmt: 'DatabaseStmt', **params) -> int | None:
        """Execute a statement and return the first column of the first row as an integer.

        Args:
            stmt: Statement or SQL string.
            **params: Bind parameters.

        Returns:
            The integer, or ``None`` if there are no rows or the value is ``NULL``.

        Raises:
            ``ValueError``: If the value is not an integer.
        """

class DatabaseInspectOptions(Data):
    """Options for database inspection."""

    refresh: bool = False
    """Whether to force inspection even if cached information is available."""
    cacheLifeTime: int = 0
    """Schema cache lifetime in seconds."""


class DatabaseProvider(Node):
    """Database provider.

    Wraps an SQLAlchemy ``Engine`` and hands out connections. Also reflects
    table structures and describes tables and columns.
    """

    def connect(self) -> 'DatabaseConnection':
        """Open a connection, to be used as a context manager.

        Calls can be nested. An inner call does not open a new connection, but
        returns a wrapper around the open one. Only the outermost connection is
        closed upon exit::

            with db.connect():
                ...
                with db.connect():  # no-op
                    ...
                # connection remains open
                ...
            # connection closed

        Returns:
            The connection.
        """

    def engine_options(self, **kwargs):
        """Add defaults to the SQLAlchemy engine options.

        Args:
            **kwargs: Engine options. Options passed here take precedence over the defaults.

        Returns:
            The options dict.
        """

    def url(self) -> str:
        """Return the connection URL.

        Returns:
            An SQLAlchemy connection URL.
        """

    def engine(self) -> 'sqlalchemy.Engine':
        """Return the SQLAlchemy ``Engine`` object for this provider, creating it if needed.

        Returns:
            The engine.
        """

    def create_engine(self, **kwargs) -> 'sqlalchemy.Engine':
        """Create a new SQLAlchemy ``Engine`` object for this provider.

        Args:
            **kwargs: Engine options, see ``engine_options``.

        Returns:
            The engine.
        """

    def describe(self, table: DatabaseTableAlike) -> 'DataSetDescription':
        """Describe a table.

        Args:
            table: Table object or table name.

        Returns:
            The table description. The first geometry column becomes the primary geometry.

        Raises:
            ``sqlalchemy.exc.SQLAlchemyError``: If the table does not exist.
        """

    def describe_column(self, table: DatabaseTableAlike, column_name: str) -> ColumnDescription:
        """Describe a column in a table.

        Args:
            table: Table object or table name.
            column_name: Column name.

        Returns:
            The column description.

        Raises:
            ``sqlalchemy.exc.SQLAlchemyError``: If the table or the column does not exist.
        """

    def table(self, table: 'DatabaseTableAlike', **kwargs) -> 'sqlalchemy.Table':
        """Return the SQLAlchemy ``Table`` object for a table.

        Args:
            table: Table object or table name.
            **kwargs: Not used by the base provider.

        Returns:
            The table object.

        Raises:
            ``sqlalchemy.exc.SQLAlchemyError``: If the table does not exist.
        """

    def column(self, table: DatabaseTableAlike, column_name: str) -> 'sqlalchemy.Column':
        """Return the SQLAlchemy ``Column`` object for a column.

        Args:
            table: Table object or table name.
            column_name: Column name.

        Returns:
            The column object.

        Raises:
            ``sqlalchemy.exc.SQLAlchemyError``: If the table or the column does not exist.
        """

    def count(self, table: DatabaseTableAlike) -> int:
        """Return the number of rows in a table.

        Args:
            table: Table object or table name.

        Returns:
            The row count, or 0 if the table does not exist.
        """

    def has_schema(self, schema_name: str) -> bool:
        """Check if a schema exists.

        Args:
            schema_name: Schema name.

        Returns:
            ``True`` if the schema exists.
        """

    def has_table(self, table_name: str) -> bool:
        """Check if a table exists.

        Args:
            table_name: Table name, optionally schema-qualified.

        Returns:
            ``True`` if the table exists.
        """

    def has_column(self, table: DatabaseTableAlike, column_name: str) -> bool:
        """Check if a column exists.

        Args:
            table: Table object or table name.
            column_name: Column name.

        Returns:
            ``True`` if the table and the column exist.
        """

    def join_table_name(self, schema: str, name: str) -> str:
        """Create a full table name from the schema and table names.

        Args:
            schema: Schema name. If empty, the default schema is used.
            name: Table name.

        Returns:
            The schema-qualified table name.
        """

    def split_table_name(self, table_name: str) -> tuple[str, str]:
        """Split a full table name into the schema and table names.

        Args:
            table_name: Table name, optionally schema-qualified.

        Returns:
            A tuple of the schema name (the default schema if none is given) and the table name.
        """

    def table_bounds(self, table: DatabaseTableAlike) -> Optional[Bounds]:
        """Compute the bounding box of the primary geometry of a table.

        Args:
            table: Table object or table name.

        Returns:
            The bounds, or ``None`` if the table has no geometry or no data.
        """

    def select_text(self, sql: str, **kwargs) -> list[dict]:
        """Execute a textual SELECT statement.

        Args:
            sql: SQL statement with ``:name`` bind parameters.
            **kwargs: Bind parameters.

        Returns:
            A list of rows as dicts.

        Raises:
            ``sqlalchemy.exc.SQLAlchemyError``: On database errors, after a rollback.
        """

    def execute_text(self, sql: str, **kwargs) -> 'sqlalchemy.CursorResult':
        """Execute a textual statement and commit.

        Args:
            sql: SQL statement with ``:name`` bind parameters.
            **kwargs: Bind parameters.

        Returns:
            The result.

        Raises:
            ``sqlalchemy.exc.SQLAlchemyError``: On database errors, after a rollback.
        """

    def schema_names(self) -> list[str]:
        """Return the names of the schemas in the database.

        Returns:
            A list of schema names.
        """

    def inspect_schema(self, schema: str, options: Optional[DatabaseInspectOptions] = None):
        """Reflect the tables of a schema and keep the result.

        A schema that has already been reflected is not reflected again, unless
        ``options.refresh`` is set. The reflected metadata is cached for the
        configured schema cache lifetime. If ``options`` are given, their
        ``cacheLifeTime`` is used instead; 0 means no caching.

        Args:
            schema: Schema name.
            options: Inspection options.
        """
