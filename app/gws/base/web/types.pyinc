class RequestMethod(Enum):
    """Web request method."""

    GET = 'GET'
    HEAD = 'HEAD'
    POST = 'POST'
    PUT = 'PUT'
    DELETE = 'DELETE'
    CONNECT = 'CONNECT'
    OPTIONS = 'OPTIONS'
    TRACE = 'TRACE'
    PATCH = 'PATCH'


class WebRequester:
    """Web requester, gives access to an incoming web request."""

    environ: dict
    """Request environment."""
    method: RequestMethod
    """Request method."""
    contentType: str
    """Request content type."""
    root: 'Root'
    """Object tree root."""
    site: 'WebSite'
    """Website the request is processed for."""

    session: 'AuthSession'
    """Current session."""
    user: 'User'
    """Current user."""

    isGet: bool
    """The request is a GET request."""
    isPost: bool
    """The request is a POST request."""
    isApi: bool
    """The request provides json data in the POST body."""
    isForm: bool
    """The request provides form data in the POST body."""
    isSecure: bool
    """The request is made over https."""

    scheme: str
    """Request scheme, http or https."""
    host: str
    """Request host name, without the port, empty if the host is invalid."""
    port: int
    """Request port, 0 if not given."""
    ip: str
    """Client address."""

    def parse(self):
        """Parse the request path, the parameters and the structured payload.

        Also determines the scheme, host, port and client address, taking proxy
        headers into account if the site has proxies.

        Raises:
            ``gws.base.web.error.HTTPException``: If the request path, the host or the payload is invalid.
        """

    def params(self) -> dict:
        """Return the GET parameters.

        Returns:
            Parameters from the query string and from the request path.
        """

    def query_params(self) -> dict:
        """Return the GET parameters from the query string.

        Returns:
            Query string parameters.
        """

    def path(self) -> str:
        """Return the request path after the command.

        Returns:
            The rest of the path after ``/_/<command>/``.
        """

    def struct(self) -> dict:
        """Return the structured payload of an API request.

        Returns:
            The decoded JSON or MessagePack payload.
        """

    def command(self) -> str:
        """Return the command name.

        Returns:
            The command from the path, or from the ``cmd`` parameter.
        """

    def data(self) -> bytes:
        """Return the raw POST data, unzipped if gzip-encoded.

        Returns:
            POST data, empty for non-POST requests.

        Raises:
            ``gws.base.web.error.HTTPException``: If the content length is invalid or too large, or the data cannot be unzipped.
        """

    def form(self) -> list[tuple[str, Any]]:
        """Return the POST form data.

        Returns:
            A list of ``(key, value)`` tuples, including uploaded files; empty if the request is not a form.

        Raises:
            ``gws.base.web.error.HTTPException``: If the form data cannot be decoded.
        """

    def text(self) -> str:
        """Return the POST data decoded to text, with the charset of the request.

        Returns:
            POST data as text.

        Raises:
            ``gws.base.web.error.HTTPException``: If the data cannot be decoded.
        """

    def cookie(self, key: str, default: str = '') -> str:
        """Get a cookie.

        Args:
            key: Cookie name.
            default: Default value.

        Returns:
            A cookie value.
        """

    def header(self, key: str, default: str = '') -> str:
        """Get a header.

        Args:
            key: Header name.
            default: Default value.

        Returns:
            A header value.
        """

    def has_param(self, key: str) -> bool:
        """Check if a GET parameter exists, ignoring case.

        Args:
            key: Parameter name.

        Returns:
            ``True`` if the parameter exists.
        """

    def param(self, key: str, default: str = '') -> str:
        """Get a GET parameter, ignoring case.

        Args:
            key: Parameter name.
            default: Default value.

        Returns:
            A parameter value.
        """

    def env(self, key: str, default: str = '') -> str:
        """Get a WSGI environment variable.

        Args:
            key: Variable name.
            default: Default value.

        Returns:
            A variable value.
        """

    def content_responder(self, response: ContentResponse) -> 'WebResponder':
        """Create a responder for a content response.

        Args:
            response: Response with literal content or a content path.

        Returns:
            A responder.
        """

    def redirect_responder(self, response: RedirectResponse) -> 'WebResponder':
        """Create a responder for a redirect response.

        Args:
            response: Redirect response.

        Returns:
            A responder.
        """

    def api_responder(self, response: Response) -> 'WebResponder':
        """Create a responder for an API (structured) response.

        The response is encoded as JSON or MessagePack, depending on the request.

        Args:
            response: Response object.

        Returns:
            A responder.
        """

    def error_responder(self, exc: Exception) -> 'WebResponder':
        """Create a responder for an exception.

        Args:
            exc: An exception; anything but an HTTP exception results in a 500 response.

        Returns:
            A responder.
        """

    def absolute_url_for(self, request_path: str, **params) -> str:
        """Create an absolute URL pointing to the requested host.

        Args:
            request_path: Request path.
            **params: Additional GET parameters.

        Returns:
            A URL.
        """

    def relative_url_for(self, request_path: str, **params) -> str:
        """Create a host-relative URL.

        Args:
            request_path: Request path.
            **params: Additional GET parameters.

        Returns:
            A URL.
        """

    def canonical_url_for(self, request_path: str, **params) -> str:
        """Create an absolute URL pointing to the canonical host.

        Args:
            request_path: Request path.
            **params: Additional GET parameters.

        Returns:
            A URL.
        """

    def set_session(self, session: 'AuthSession'):
        """Attach a session to the requester and set the user from it.

        Args:
            session: A session object.
        """


class WebResponder:
    """Web responder, builds and sends the response to a web request."""

    status: int
    """Response status."""

    def send_response(self, environ: dict, start_response: Callable):
        """Send the response to the client.

        Args:
            environ: WSGI environment.
            start_response: WSGI ``start_response`` function.

        Returns:
            The WSGI response iterable.
        """

    def set_cookie(self, key: str, value: str, **kwargs):
        """Set a cookie.

        Args:
            key: Cookie name.
            value: Cookie value.
            **kwargs: Cookie options.
        """

    def delete_cookie(self, key: str, **kwargs):
        """Delete a cookie.

        Args:
            key: Cookie name.
            **kwargs: Cookie options.
        """

    def set_status(self, status: int):
        """Set the response status.

        Args:
            status: HTTP status code.
        """

    def add_header(self, key: str, value: str):
        """Add a header.

        Args:
            key: Header name.
            value: Header value.
        """

    def set_body(self, body: str | bytes):
        """Set the response body.

        Args:
            body: New response body; strings are encoded as UTF-8.
        """


class WebDocumentRoot(Data):
    """Directory served over the web."""

    dir: DirPath
    """Local directory."""
    allowMime: list[str]
    """Allowed mime types."""
    denyMime: list[str]
    """Restricted mime types."""


class WebRewriteRule(Data):
    """URL rewrite rule."""

    pattern: Regex
    """URL matching pattern."""
    target: str
    """Rule target, with ``$1``, ``$2`` etc. placeholders for the pattern groups."""
    options: dict
    """Extra options."""
    reversed: bool
    """The rule rewrites URLs generated by the server, not incoming URLs."""


class WebCors(Data):
    """CORS options."""

    allowCredentials: bool
    """Allow credentials in cross-origin requests."""
    allowHeaders: str
    """Headers allowed in cross-origin requests."""
    allowMethods: str
    """Methods allowed in cross-origin requests."""
    allowOrigin: str
    """Origins allowed to make cross-origin requests."""


class WebManager(Node):
    """Web manager, holds the web site."""

    site: 'WebSite'
    """Configured web site."""


class WebSite(Node):
    """Web site the server responds to."""

    assetsRoot: Optional[WebDocumentRoot]
    """Root directory for assets."""
    canonicalHost: str
    """Host name for absolute canonical URLs."""
    corsOptions: WebCors
    """CORS options."""
    hostnames: list[str]
    """Host names this site responds to."""
    rewriteRules: list[WebRewriteRule]
    """URL rewrite rules."""
    proxyCount: int
    """Number of proxies in front of the server."""
    ssl: bool
    """The site is served over https."""
    staticRoot: WebDocumentRoot
    """Root directory for static files."""

    def url_for(self, req: 'WebRequester', path: str, mode: str, **params) -> str:
        """Create a URL for a request path, applying the reversed rewrite rules.

        If the path, or the rewritten path, is an absolute URL, only the parameters
        are added. In the ``absolute`` and ``canonical`` modes, the URL gets the scheme
        of the request. The host is the canonical host in the ``canonical`` mode, and
        the request host and port otherwise or if there is no canonical host.

        Args:
            req: Web requester.
            path: Request path.
            mode: ``absolute``, ``relative`` or ``canonical``.
            **params: Extra GET parameters.

        Returns:
            A URL.

        Raises:
            ``gws.BadRequestError``: If an absolute URL is requested and there is no host.
        """
