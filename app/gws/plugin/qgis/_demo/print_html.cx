uid "qgis_print_html"

title "QGIS Druckvorlage mit HTML-Element"

metadata.keywords [ "qgis" "drucken" ]

metadata.abstract """
Druck mit QGIS-Druckvorlagen, deren HTML-Element mit Platzhaltern der WebSuite gefüllt wird.

Zum Ausprobieren den Druck in der Werkzeugleiste öffnen, eine der Druckvorlagen "Portrait" oder "Landscape" und eine Druckqualität wählen und drucken. Das HTML-Element im PDF zeigt u. a. Projekttitel, Benutzer, Version, Maßstab, Drehung, KBS, Auflösung, Datum und Uhrzeit.

Die beiden `printers` verwenden Vorlagen `type "qgis"` aus demselben QGIS-Projekt; `index` wählt das Layout aus. Text- und HTML-Elemente des Layouts werden als HTML-Vorlagen der WebSuite ausgewertet, sodass Platzhalter wie `{{project.title}}`, `{{scale}}` oder `{{date.medium}}` beim Drucken ersetzt werden. `qualityLevels` legt die wählbaren Auflösungen fest.
"""

printers+ {
    template {
        type "qgis"
        provider.path "print_html.qgs"
        index 0
    }
    qualityLevels [ { dpi  72 name "nice vectors" } { dpi 150 name "good quality" } ]
}

printers+ {
    template {
        type "qgis"
        provider.path "print_html.qgs"
        index 1
    }
    qualityLevels [ { dpi  72 name "nice vectors" } { dpi 150 name "good quality" } ]
}

map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 250000
    zoom.maxScale  1000000
}

map.layers+ {
    title "Bank"
    type "geojson"
    provider.path "/demos/poi/poi.bank.geojson"
    cssSelector ".custom_poi_bank"
    templates+ {
        subject "feature.label"
        type "html"
        text "{{name}}"
    }
}

map.layers+ {
    title "Districts"
    type "postgres"
    tableName "edit.district"
    cssSelector ".custom_district"
    templates+ {
        subject "feature.label"
        type "html"
        text "{{name}}"
    }
}

{demo_osm_background}
