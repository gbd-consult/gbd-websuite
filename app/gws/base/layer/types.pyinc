class LayerDisplayMode(Enum):
    """How a layer is rendered."""

    box = 'box'
    """Render the map view as a single image."""
    tile = 'tile'
    """Render the layer as tiles of a grid."""
    client = 'client'
    """Let the client render the layer from its source."""


class FeatureLoadingStrategy(Enum):
    """When the client loads a layer's features."""

    all = 'all'
    """Load all features once, on first display."""
    bbox = 'bbox'
    """Reload features for the current map extent whenever it changes."""
    lazy = 'lazy'
    """Load features only when a search text is entered."""


class LayerOwsBinding(Node):
    """Binding of a layer to OWS services: access, names and models."""

    allowedServiceUids: list[str]
    """UIDs of services which can use this layer; empty means any."""
    deniedServiceUids: list[str]
    """UIDs of services which can not use this layer."""
    featureName: str
    """Name for features in this layer."""
    geometryName: str
    """Name for geometries in this layer."""
    layerName: str
    """Name for this layer in OWS services."""
    models: list['Model']
    """OWS-specific models."""
    xmlNamespace: Optional['XmlNamespace']
    """XML namespace for feature and layer names."""


class Layer(Node):
    """Layer object."""

    bounds: Bounds
    """Bounds in the map CRS: the WGS extent clipped to the parent extent and to the CRS."""
    canRenderBox: bool
    """The layer can render a single image for an arbitrary extent."""
    canRenderInClient: bool
    """The layer can be drawn by the client directly from its source (``display: client``)."""
    canRenderSvg: bool
    """The layer can render its features as SVG."""
    canRenderTile: bool
    """The layer can render tiles in a fixed grid."""
    cssSelector: str
    """CSS selector for feature styling."""
    displayMode: LayerDisplayMode
    """How the client displays the layer."""
    finders: list['Finder']
    """Search providers."""
    grabbers: dict[int, 'Grabber']
    """Grabbers by CRS code, one for each CRS the application supports."""
    hasLegend: bool
    """The layer has a legend."""
    imageFormat: ImageFormat
    """Image format for box and tile rendering."""
    isEnabledForOws: bool
    """The layer can be used by OWS services."""
    isGroup: bool
    """The layer is a group of other layers."""
    isSearchable: bool
    """The layer has at least one search provider."""
    layers: list['Layer']
    """Child layers."""
    legend: Optional['Legend']
    """Legend object."""
    loadingStrategy: FeatureLoadingStrategy
    """How the client loads features."""
    mapCrs: 'Crs'
    """CRS of the map this layer belongs to."""
    metadata: 'Metadata'
    """Layer metadata."""
    models: list['Model']
    """Data models."""
    opacity: float
    """Layer opacity, 0 to 1."""
    ows: 'LayerOwsBinding'
    """Binding to OWS services."""
    resolutions: list[float]
    """Resolutions the layer is visible at, in map units per pixel."""
    sourceLayers: list['SourceLayer']
    """Source layers this layer is built from."""
    templates: list['Template']
    """Layer templates."""
    title: str
    """Layer title."""
    wgsExtent: Extent
    """Layer extent in WGS84."""
    zoomBounds: Bounds
    """Bounds the client zooms to for this layer; defaults to ``bounds``."""

    def find_features(self, search: 'SearchQuery', user: 'User') -> list['Feature']:
        """Find features in the layer.

        Vector layers search in the first model the user can read; other
        layers return an empty list.

        Args:
            search: Search query.
            user: The user who searches.

        Returns:
            Found features.
        """

    def render(self, lri: LayerRenderInput) -> Optional['LayerRenderOutput']:
        """Render a box, a tile or an SVG fragment, depending on the input type.

        Args:
            lri: Render input.

        Returns:
            Render output with image content or SVG tags, or ``None`` if the
            layer has nothing to render.
        """

    def render_legend(self, args: Optional[dict | Data] = None) -> Optional['LegendRenderOutput']:
        """Render the layer legend.

        Without ``args`` the output is cached for the server lifetime.

        Args:
            args: Arguments passed to the legend renderer.

        Returns:
            Legend output, or ``None`` if the layer has no legend.
        """

    def url_path_for(self, kind: str) -> str:
        """Return the URL path for requests to this layer.

        Args:
            kind: ``box``, ``tile``, ``legend`` or ``features``. The ``tile``
                path contains ``{z}``, ``{x}`` and ``{y}`` placeholders.

        Returns:
            URL path.

        Raises:
            ``gws.Error``: If ``kind`` is not recognized.
        """
