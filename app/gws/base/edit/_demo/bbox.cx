uid "edit_bbox"

title "Editieren im aktuellen Kartenausschnitt"

metadata.keywords [ "edit" "datenbank" "vektordaten" ]

metadata.abstract """
Bearbeiten von Punkten aus einer PostgreSQL Tabelle, wobei nur die Objekte im aktuellen Kartenausschnitt geladen werden.

Mit `loadingStrategy "bbox"` am Layer lädt der Client die Objekte bei jeder Änderung des Kartenausschnitts neu; das Modell übernimmt die Ladestrategie des Layers. Beim Verschieben oder Zoomen der Karte ändert sich die Objektliste im Reiter "Editieren" entsprechend.

Das Modell hat keine `fields`, das Formular wird automatisch erzeugt; `sort` sortiert die Liste nach `name`. Die Vorlagen `feature.title` und `feature.label` zeigen den Namen in der Liste und als Beschriftung auf der Karte, die Darstellung kommt aus `cssSelector ".custom_poi"`.
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }


map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 4000
    zoom.maxScale  1000000
    zoom.minScale  100
}

map.layers+ {
    title "Interessante Orte"
    type "postgres"
    tableName "edit.poi"
    loadingStrategy "bbox"
    cssSelector ".custom_poi"

    models+ {
        type "postgres"
        isEditable true
        permissions.edit 'allow all'
        sort+ { fieldName "name" }

    }

    templates+ {
        subject "feature.label"
        type "html"
        text "{{name}}"
    }
    templates+ {
        subject "feature.title"
        type "html"
        text "{{name}}"
    }
}

{demo_osm_background}
