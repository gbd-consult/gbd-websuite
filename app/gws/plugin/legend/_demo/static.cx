uid "legend_static"

title "Statische Legende aus Bilddatei"

metadata.keywords [ "karte" "rasterdaten" ]

metadata.abstract """
Ein Layer erhält als Legende ein festes PNG-Bild.

Im Seitenleisten-Reiter „Layer“ auf den Layer „OpenStreetMap“ klicken; die Legende erscheint in den Layer-Details.

Ein Kachel-Layer liefert selbst keine Legende. Der Block `legend` mit `type "static"` und `path "osm_legend.png"` bindet stattdessen eine Bilddatei ein. Der Pfad ist relativ zur Konfigurationsdatei.
"""

map {
    crs 3857
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
}

map.layers+ {
    title "OpenStreetMap"
    type "tile"
    provider.url "https://geoservices.gbd-consult.de/xyz/light/{{z}}/{{x}}/{{y}}.png?key=gwsdemo"
    display "client"

    legend {
        type "static"
        path "osm_legend.png"
    }
    metadata.attribution "© <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"
}

