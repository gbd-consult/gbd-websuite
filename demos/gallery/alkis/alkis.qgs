        <layer-tree-layer source="service='DB_ALKIS' key='ogc_fid' estimatedmetadata=true srid=25832 type=MultiPoint checkPrimaryKeyUnicity='0' table=&quot;(SELECT ogc_fid,layer,CASE WHEN grad_pt&lt;0 THEN abs(s.grad_pt) ELSE 0.25*coalesce(skalierung,1)*s.grad_pt*1.3225 END AS tsize,CASE WHEN grad_pt&lt;0 THEN 'Point' ELSE 'MapUnit' END AS tunit,text,CASE coalesce(po_labels.horizontaleausrichtung,s.horizontaleausrichtung) WHEN 'linksbündig' THEN 'Left' WHEN 'rechtsbündig' THEN 'Right' ELSE 'Center' END AS halign,CASE coalesce(po_labels.vertikaleausrichtung,s.vertikaleausrichtung) WHEN 'oben' THEN 'Cap' WHEN 'Basis' THEN 'Base' ELSE 'Half' END AS valign,coalesce(s.art,'Arial'::text) AS family,CASE WHEN s.stil LIKE '%Kursiv%' THEN 1 ELSE 0 END AS italic,CASE WHEN s.stil LIKE '%Fett%' THEN 1 ELSE 0 END AS bold,coalesce(sperrung_pt*0.25,0) AS fontsperrung,replace(f.umn,' ',',') AS tcolor,CASE WHEN grad_pt&lt;0 THEN 0 ELSE 1 END AS tshow,point,st_x(point) AS tx,st_y(point) AS ty,drehwinkel_grad AS tangle FROM \&quot;alkis\&quot;.po_labels LEFT OUTER JOIN \&quot;alkis\&quot;.alkis_schriften s ON po_labels.signaturnummer=s.signaturnummer AND s.katalog=1 LEFT OUTER JOIN \&quot;alkis\&quot;.alkis_farben f ON s.farbe=f.id WHERE thema='Industrie und Gewerbe' AND modell &amp;&amp; ARRAY['DLKM','DKKM1000']::varchar[])&quot; (point)" expanded="1" checked="Qt::Checked" name="Beschriftungen (Industrie und Gewerbe)" legend_exp="" id="Beschriftungen__Industrie_und_Gewerbe__3cacfd57_1900_442d_aa5b_8b6395266713" providerKey="postgres" legend_split_behavior="0" patch_size="-1,-1">
