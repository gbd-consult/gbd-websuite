uid "value_current_user"

title "Editieren mit automatischem Bearbeiter"

metadata.keywords [ "edit" "datenbank" ]

metadata.abstract """
Ein Feld, das beim Speichern automatisch den Anmeldenamen des aktuellen Nutzers erhält.

Im Reiter "Editieren" das Modell "Districts" wählen, einen Stadtteil öffnen, z. B. den Namen ändern und speichern. Das Feld "Updated by" zeigt danach den Anmeldenamen des Nutzers, der gespeichert hat.

Das Feld hat die Wertquelle `values` mit `type "currentUser"`. `forUpdate true` und `forRead false` bewirken, dass der Wert beim Speichern gesetzt wird, nicht beim Lesen. `permissions.edit "deny all"` verhindert eine manuelle Eingabe.
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }


map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}

models+ {
    title "Districts"
    type "postgres"
    tableName "edit.district"
    isEditable true
    permissions.edit 'allow all'
    fields+ {
        name "sid"
        type "text"
        title "Identifier"
        isPrimaryKey true
        permissions.edit "deny all"
    }

    fields+ {
        name "name"
        type "text"
        title "Object name"
    }

    fields+ {
        name "updated_by"
        type "text"
        title "Updated by"
        permissions.edit "deny all"
        values+ {
            type "currentUser"
            forRead false
            forUpdate true
        }
    }

    templates+ { subject "feature.label" type "html" text "{{name}}" }
    templates+ { subject "feature.title" type "html" text "{{name}}" }

}

map.layers+ {
    title "Districts"
    type "postgres"
    tableName "edit.district"
}

{demo_osm_background}
