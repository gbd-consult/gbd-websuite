uid "service_wmts_raster_demo"

title "WMTS Dienst aus Rasterlayer"

metadata.keywords [ "ows-dienste" "wmts" "rasterdaten" ]

metadata.abstract """
Ein von der WebSuite bereitgestellter WMTS-Dienst, der Kacheln aus einem GeoTIFF liefert, einer Sentinel-2-Aufnahme in Echtfarben.

Beim Laden des Dienstes in einer externen Anwendung wie QGIS stehen Kachelmatrix-Sätze für EPSG:3857, EPSG:25832 und EPSG:25833 zur Auswahl.

Den Karteninhalt liefert ein Layer vom Typ `raster` mit `provider.paths`. Der `owsServices`-Eintrag vom Typ `wmts` erzeugt mit `supportedCrs [ 3857 25832 25833 ]` je einen `TileMatrixSet` pro KBS; `map.extent` begrenzt die Kachelmatrix auf die Umgebung von Düsseldorf.

[Service URL](/_/owsService/serviceUid/service_wmts_raster?request=GetCapabilities)

[Demo QGIS Project](/ows_services.qgs)
"""

owsServices+ {
    type "wmts"
    uid "service_wmts_raster"
    supportedCrs [ 3857 25832 25833 ]
    metadata {
        abstract "Raster WMTS service"
        keywords ["test" "wmts" "demo"]
        name "WMTS_RASTER"
        title "Raster WMTS"
        {demo_metadata}
    }
}

map.extent [
    {demo_point_duesseldorf_3857[0] - 30000}
    {demo_point_duesseldorf_3857[1] - 30000}
    {demo_point_duesseldorf_3857[0] + 30000}
    {demo_point_duesseldorf_3857[1] + 30000}
]

map.layers+ {
    type "raster"
    title "Düsseldorf"
    provider.paths [ "/gws-extern/demos/S2A_32ULB_20250811_TCI.tif" ]
}
