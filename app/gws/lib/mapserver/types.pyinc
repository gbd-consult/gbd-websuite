class MapServerLayerType(Enum):
    """MapServer layer type."""

    point = 'point'
    """Point layer."""
    line = 'line'
    """Line layer."""
    polygon = 'polygon'
    """Polygon layer."""
    raster = 'raster'
    """Raster layer."""

class MapServerLayerOptions(Data):
    """Options for a MapServer-based layer."""

    type: MapServerLayerType
    """Layer type."""
    path: str
    """Path to the data file, e.g. an image (layer DATA option)."""
    tileIndex: str
    """Path to the tile index SHP file."""
    crs: 'Crs'
    """Layer CRS."""
    connectionType: str
    """Type of connection, only ``postgres`` is supported."""
    connectionString: str
    """Connection string for the data source."""
    dataString: str
    """Layer DATA option, overrides ``path``."""
    style: 'StyleValues'
    """Style for the layer; only a part of the style values is supported."""
    processing: list[str]
    """Processing options for the layer."""
    transparentColor: str
    """Color to treat as transparent in the layer (OFFSITE)."""
    sldPath: str
    """Path to SLD file for styling the layer."""
    sldName: str
    """Name of an SLD NamedLayer to apply."""
