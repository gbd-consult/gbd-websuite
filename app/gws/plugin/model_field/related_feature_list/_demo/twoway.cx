uid "field_related_feature_list_2"

title "Editieren 1:N-Beziehung in beide Richtungen"

metadata.keywords [ "edit" "datenbank" ]

metadata.abstract """
Eine 1:N-Beziehung zwischen Kategorien und POIs, die in beiden Modellen bearbeitet werden kann.

Im Reiter "Editieren" das Modell "POIs" wählen und ein Objekt öffnen: Das Feld "Category" wählt die Kategorie aus einer Auswahlliste. Im Modell "Categories" listet das Feld "POIs" alle POIs der Kategorie.

Beide Felder beschreiben dieselbe Fremdschlüsselspalte `category_id` der POI-Tabelle: auf der POI-Seite als `type "relatedFeature"` mit dem Widget `featureSelect` (`fromColumn "category_id"`, `toColumn "id"`), auf der Kategorie-Seite als `type "relatedFeatureList"` mit dem Widget `featureList` (`fromColumn "id"`, `toColumn "category_id"`). Eine Änderung auf einer Seite ist deshalb auch auf der anderen sichtbar.
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }


map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}

models+ {
    type "postgres"
    uid "model_poi_002"
    tableName "edit.poi_small"
    sort+ { fieldName "name" }
    title "POIs"
    isEditable true
    permissions.edit "allow all"

    fields+ { name "id" type "integer" title "Identifier" isPrimaryKey true permissions.edit "deny all" }
    fields+ { name "name" type "text" title "Name" isRequired true textSearch { type "any" } }
    fields+ { name "geom" type "geometry" title "Geometry" isRequired true }

    fields+ {
        name "category"
        title "Category"
        type "relatedFeature"
        fromColumn "category_id"
        toModel "model_category_002"
        toColumn "id"
        widget.type "featureSelect"
    }

    templates+ {
        subject "feature.title"
        type "html"
        text "{{@if feature.isNew}} Unbenannt {{@else}} {{name}} {{@end}}"
    }
}

models+ {
    type "postgres"
    uid "model_category_002"
    tableName "edit.category"
    title "Categories"
    sort+ { fieldName "name_de" }
    isEditable true
    permissions.edit "allow all"

    fields+ { name "id" type "integer" title "Identifier" isPrimaryKey true permissions.edit "deny all" }
    fields+ { name "name_de" type "text" title "Name (DE)" isRequired true textSearch { type "any" } }
    fields+ { name "name_en" type "text" title "Name (EN)" isRequired true textSearch { type "any" } }

    fields+ {
        name "pois"
        title "POIs"
        type "relatedFeatureList"
        fromColumn "id"
        toModel "model_poi_002"
        toColumn "category_id"
        widget.type "featureList"
    }

    templates+ { subject "feature.title" type "html" text "{{name_de}}" }
}

{demo_osm_background}
