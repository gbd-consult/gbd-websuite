uid "baumerfassung"

title "Baumerfassung mit QField"

permissions.read "allow all"

metadata.keywords [ "qfield" "qgis" "edit" "datenbank" ]

metadata.abstract """
Diese Daten können mit QField auf einem mobilen Gerät bearbeitet werden.

Um die Daten zu bearbeiten, benutzen Sie bitte die QField App. Unter "QFieldCloud Projekte" melden Sie sich zunächst mit folgenden Zugangsdaten an:

- **Server**: https://docs.gbd-websuite.de/baum
- **Benutzername**: demo1
- **Passwort**: demo

Laden Sie das Projekt "Baumerfassung" herunter und öffnen Sie es in QField. Editieren Sie die Daten, danach aus dem QFieldCloud-Menü "Synchronisieren" wählen.

Anschließend laden Sie diese Seite neu, um die Änderungen in der Webkarte zu sehen.
"""

map.crs 25832
map.center [ 346783 5678994 ]
map.zoom.initScale 2000

map.layers+ {
    title "Baum"
    type "qgisflat"
    provider { dbUid "DB_QFIELD" schema "erfassung" projectName "baumerfassung" }
    sourceLayers.names [ "Baum" ]

    finders+ {
        type "postgres"
        dbUid "DB_QFIELD"
        tableName "erfassung.v_baum_info"
        models+ {
            type "postgres"
            withAutoFields true
            fields+ {
                name "id"
                type "integer"
                isPrimaryKey true
            }
            fields+ {
                name "baumart_deu_name"
                type "text"
                textSearch { type "any" minLength 2 }
            }
        }
        templates+ {
            subject "feature.description"
            type "html"
            path "/demos/gallery/baumerfassung/feature_description.cx.html"
        }
    }
}
map.layers+ {
    title "Wegenetz (Status)"
    type "qgisflat"
    provider { dbUid "DB_QFIELD" schema "erfassung" projectName "baumerfassung" }
    sourceLayers.names [ "Wegenetz (Status)" ]
}

{demo_osm_background_32}

actions+ {
    type "qfieldcloud"
    permissions.read "allow all"
    projects+ {
        uid "baumerfassung"
        title "Baumerfassung"
        provider { dbUid "DB_QFIELD" schema "erfassung" projectName "baumerfassung" }
        mapCacheLifeTime "7d"
        permissions.read "allow user, deny all"
        syncFiles+ { field "file_foto" useBlob true }
        syncFiles+ { field "file_foto_protokoll" useBlob true }
        models+ {
            uid "model_qfield_baum"
            title "Baum"
            type "postgres"
            dbUid "DB_QFIELD"
            tableName "erfassung.baum"
            withAutoFields true
            isEditable true
            permissions.read "allow all"
            permissions.edit "allow user, deny all"
            fields+ {
                name "file_anhang"
                title "Anhang"
                type "file"
                contentColumn "anhang_content"
                nameColumn "anhang"
            }
            fields+ {
                name "file_foto"
                title "Foto"
                type "file"
                contentColumn "foto_content"
                nameColumn "foto"
            }
        }
        models+ {
            uid "model_qfield_baum_protokoll"
            title "Protokoll"
            type "postgres"
            dbUid "DB_QFIELD"
            tableName "erfassung.protokoll"
            withAutoFields true
            isEditable true
            permissions.read "allow all"
            permissions.edit "allow user, deny all"
            fields+ {
                name "file_foto_protokoll"
                title "Foto"
                type "file"
                contentColumn "foto_content"
                nameColumn "foto"
            }
        }
    }
}
