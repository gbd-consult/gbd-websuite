uid "edit_tabview"

title "Editieren in der Attributtabelle"

metadata.keywords [ "edit" "datenbank" ]

metadata.abstract """
Bearbeiten von PostgreSQL Daten in einer Tabellenansicht, einmal automatisch und einmal angepasst konfiguriert.

Im Reiter "Editieren" ein Modell wählen und unten in der Leiste auf "Attributtabelle öffnen" klicken. Die Tabelle zeigt die Objekte des Modells; Werte werden in den Zellen bearbeitet und gespeichert.

Die Modelle sind auf Projektebene unter `models` definiert, nicht an einem Layer. "Kategorisierte Orte" hat keine `tableViewColumns`; die Tabelle zeigt dann alle Felder, deren Widget in einer Tabelle darstellbar ist. "Interessante Orte" legt mit `tableViewColumns` Reihenfolge und Breite der Spalten fest; dort werden der Code mit dem Widget `select` und das Datum mit dem Widget `date` bearbeitet.

Die Tabellenansicht ist per Vorgabe aktiv und lässt sich mit `withTableView false` abschalten.
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }


map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}


models+ {
    title "Kategorisierte Orte (automatische Tabellenansicht)"
    type "postgres"
    tableName "edit.category"
    sort+ { fieldName "name_de" }
    isEditable true
    permissions.edit "allow all"

    fields+ {
        name "id"
        type "integer"
        title "Identifier"
        isPrimaryKey true
        isRequired true
    }

    fields+ {
        name "name_de"
        type "text"
        title "Name (DE)"
        isRequired true
        textSearch { type "any" }
    }
    fields+ {
        name "name_en"
        type "text"
        title "Name (EN)"
        isRequired true
        textSearch { type "any" }
    }
    fields+ {
        name "description"
        type "text"
        title "Description"
    }

    templates+ {
        subject "feature.title"
        type "html"
        text "{{name_de}}"
    }
}

models+ {
    title "Interessante Orte (angepasste Tabellenansicht)"
    type "postgres"
    tableName "edit.poi"
    sort+ { fieldName "name" }
    isEditable true
    permissions.edit "allow all"

    tableViewColumns [
        { name "name" width 150 }
        { name "updated" width 100 }
        { name "code" width 300 }
        { name "description" }
    ]

    fields+ {
        name "id"
        type "integer"
        title "Identifier"
        isPrimaryKey true
        isRequired true
        permissions.edit "deny all"
        widget { type "input" }
    }

    fields+ {
        name "name"
        type "text"
        title "Object name"
        isRequired true
        widget { type "input" }
        textSearch { type "any" }
    }

    fields+ {
        name "code"
        type "integer"
        title "Feature Code"
        widget {
            type "select"
            items [
                { value 0  text "unknown" }
                { value 100  text "primary feature" }
                { value 200  text "secondary feature" }
                { value 300  text "tertiary feature" }
            ]
        }
    }

    fields+ {
        name "updated"
        type "date"
        title "Date updated"
        widget {
            type "date"
        }
    }

    fields+ {
        name "description"
        type "text"
        title "Comments"
        widget { type "textarea" height 150 }
    }

    fields+ {
        name "geom"
        type "geometry"
        title "Geometry"
    }

    templates+ {
        subject "feature.title"
        type "html"
        text "{{name}} {{id}}"
    }

    templates+ {
        subject "feature.label"
        type "html"
        text "{{name}}"
    }
}




map.layers+ {
    title "POIs"
    type "postgres"
    tableName "edit.poi"
    extent [ 431881, 6505964, 1076161, 6877804 ]
}

{demo_osm_background}
