uid "geometry_text"

title "Editieren von Geometrien als Text"

metadata.keywords [ "edit" "vektordaten" ]

metadata.abstract """
Geometrien als Text eingeben und ändern, statt sie auf der Karte zu zeichnen.

Beim Modell "POI (default geometry)" steht unten in der Objektliste die Schaltfläche "Geometrie als Text erfassen", mit der ein neuer Punkt über seine Koordinaten angelegt wird. Beim Modell "Districts (inline geometry)" wird die Geometrie eines geöffneten Objekts mit "Geometrie als Text bearbeiten" geändert. Der Dialog zeigt die Geometrie als WKT, bei Punkten zusätzlich Eingabefelder für X und Y.

Konfiguriert wird das mit `withText true` am Widget `geometry`. Die Schaltfläche zum Erfassen eines neuen Objekts als Text gibt es nur für Punkt-Modelle. Beim Stadtteil-Modell ist das Widget zusätzlich mit `isInline true` in das Formular eingebettet.
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }


map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}


models+ {
    type "postgres"
    tableName "edit.poi"
    title "POI (default geometry)"
    uid "model_geometry_3"
    sort+ { fieldName "name" }
    isEditable true
    permissions.edit "allow all"

    fields+ { name "id" type "integer" isPrimaryKey true permissions.edit "deny all" }
    fields+ { name "name" type "text" title "Name" }

    fields+ {
        name "geom"
        type "geometry"
        title "Geometry"
        widget { type "geometry" withText true }
    }

    templates+ { subject "feature.title" type "html" text "{{name}}" }
    templates+ { subject "feature.label" type "html" text "{{name}}" }
}

models+ {
    type "postgres"
    tableName "edit.district"
    title "Districts (inline geometry)"
    uid "model_geometry_4"
    sort+ { fieldName "name" }
    isEditable true
    permissions.edit "allow all"

    fields+ { name "sid" type "text" isPrimaryKey true permissions.edit "deny all" }
    fields+ { name "name" type "text" title "Name" }

    fields+ {
        name "geom"
        type "geometry"
        title "Geometry"
        widget { type "geometry" isInline true withText true }
    }

    templates+ { subject "feature.title" type "html" text "{{name}}" }
    templates+ { subject "feature.label" type "html" text "{{name}}" }
}

map.layers+ {
    title "POIs"
    type "postgres"
    tableName "edit.poi"
    extent [ 431881, 6505964, 1076161, 6877804 ]
}

map.layers+ {
    title "Districts"
    type "postgres"
    tableName "edit.district"
}

{demo_osm_background}
