uid "geojson_layer"

title "GeoJSON Layer aus Dateien"

metadata.keywords [ "vektordaten" "karte" ]

metadata.abstract """
Vektorlayer aus GeoJSON-Dateien: Banken als Punkte und Stadtbezirke als Flächen in Düsseldorf.

Beide Layer erscheinen im Layerbaum und können dort ein- und ausgeblendet werden.

Jeder Layer hat `type "geojson"`, die Datei wird mit `provider.path` angegeben. Die Features werden als Vektordaten an den Client übertragen und dort gezeichnet.
"""

map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}

map.layers+ {
    title "Bank"
    type "geojson"
    provider.path "/demos/poi/poi.bank.geojson"
}

map.layers+ {
    title "Districts"
    type "geojson"
    provider.path "/demos/districts.geojson"
}

{demo_osm_background}
