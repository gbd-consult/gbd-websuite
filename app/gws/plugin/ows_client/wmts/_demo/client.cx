uid "wmts_client_layer"

title "Client-side WMTS layer"

metadata.keywords [ "wmts" "ows" ]

metadata.abstract """
Client-side display of `wmts` layers
"""

map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 70000
}

map.layers+ {
    title "basemap.de"
    type "wmts"
    display "client"
    provider.url "https://sgx.geodatenzentrum.de/wmts_basemapde/1.0.0/WMTSCapabilities.xml"
    sourceLayers.names ["de_basemapde_web_raster_farbe"]
    metadata.attribution "© <a href='https://basemap.de'>basemap.de</a> / BKG"
    withCache false
}

{demo_osm_background}
