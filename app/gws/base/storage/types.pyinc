class StorageManager(Node):
    """Storage manager, holds the storage providers."""

    providers: list['StorageProvider']
    """Configured storage providers."""

    def create_provider(self, cfg: Config, **kwargs) -> 'StorageProvider':
        """Create a storage provider and add it to the manager.

        A provider with the same uid replaces the existing one.

        Args:
            cfg: Provider configuration.
            **kwargs: Extra configuration values.

        Returns:
            The new provider.
        """

    def find_provider(self, uid: Optional[str] = None) -> Optional['StorageProvider']:
        """Find a storage provider.

        Args:
            uid: Provider uid. If not given, the first provider is returned.

        Returns:
            The provider, or ``None`` if not found.
        """



class StorageRecord(Data):
    """Storage record."""

    name: str
    """Record name."""
    userUid: str
    """Uid of the user who last wrote the record."""
    data: str
    """Serialized record data."""
    created: 'datetime.datetime'
    """Record create time."""
    updated: 'datetime.datetime'
    """Record update time."""


class StorageProvider(Node):
    """Storage provider, stores named records grouped by category."""

    def list_names(self, category: str) -> list[str]:
        """List the record names in a category.

        Args:
            category: Category name.

        Returns:
            Record names.
        """

    def read(self, category: str, name: str) -> Optional['StorageRecord']:
        """Read a record.

        Args:
            category: Category name.
            name: Record name.

        Returns:
            The record, or ``None`` if not found.
        """

    def write(self, category: str, name: str, data: str, user_uid: str):
        """Create a record or update an existing one.

        Args:
            category: Category name.
            name: Record name.
            data: Serialized record data.
            user_uid: Uid of the user who writes the record.
        """

    def delete(self, category: str, name: str):
        """Delete a record.

        Args:
            category: Category name.
            name: Record name.
        """

