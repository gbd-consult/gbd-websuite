    <QFieldSync>
      <attachmentDirs type="QStringList">
        <value>DCIM</value>
      </attachmentDirs>
      <dataDirs type="QStringList"/>
      <dirsToCopy type="QString">{"DCIM": true, "DCIM/sub": true, "skipped": false, "/tmp/qfc_abs": true}</dirsToCopy>
