uid "tile_client"

title "Kachellayer, Darstellung im Client"

metadata.keywords [ "karte" "rasterdaten" ]

metadata.abstract """
XYZ-Kacheln von Google Maps, die der Browser direkt vom Dienst abruft.

Die vier Varianten (Straßenkarte, Straßennamen, Satellit, Gelände) sind in einer Gruppe zusammengefasst. Die Gruppe ist mit `clientOptions.exclusive true` exklusiv, so dass im Layerbaum immer nur eine Variante sichtbar ist.

Jeder Layer hat `type "tile"`, die Kachel-URL wird mit `provider.url` und den Platzhaltern `{{x}}`, `{{y}}`, `{{z}}` angegeben. Mit `display "client"` werden die Kacheln nicht über den Server geleitet, sondern im Client direkt geladen.
"""

map {
    crs 3857
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
}

map.layers+ {
    title "Google"
    type "group"
    clientOptions.exclusive true
    clientOptions.expanded true

    layers+ {
        title "Road Map"
        type "tile"
        provider.url "http://mt1.google.com/vt/lyrs=m&x={{x}}&y={{y}}&z={{z}}"
        display "client"
    }
    layers+ {
        title "Road Names"
        type "tile"
        provider.url "http://mt1.google.com/vt/lyrs=h&x={{x}}&y={{y}}&z={{z}}"
        display "client"
        clientOptions.hidden true
    }
    layers+ {
        title "Satellite"
        type "tile"
        provider.url "http://mt1.google.com/vt/lyrs=s&hl=pl&&x={{x}}&y={{y}}&z={{z}}"
        display "client"
        clientOptions.hidden true
    }
    layers+ {
        title "Terrain"
        type "tile"
        provider.url "http://mt1.google.com/vt/lyrs=t&x={{x}}&y={{y}}&z={{z}}"
        display "client"
        clientOptions.hidden true
    }
}

{demo_osm_background}
