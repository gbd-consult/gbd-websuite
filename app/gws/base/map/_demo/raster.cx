uid "map_raster"

title "Darstellung von Rasterlayern"

metadata.keywords [ "tile" "wms" "wmts" "raster" ]

metadata.abstract """
Rasterlayer aus verschiedenen Quellen (WMTS, WMS, GeoTIFF, Kachel-Dienste),
alle auf dem Server gerendert.
"""

map {
    crs 3857
    center {demo_point_duesseldorf_3857}
}

map.layers+ {
    title "NRW ALKIS (WMS)"
    type "wmsflat"
    display "tile"
    provider.url "https://www.wms.nrw.de/geobasis/wms_nw_alkis"
    sourceLayers.names [
        "adv_alkis_gewaesser"
        "adv_alkis_vegetation"
        "adv_alkis_verkehr"
        "adv_alkis_gebaeude"
        "adv_alkis_flurstuecke"
    ]
    metadata.attribution "© <a href='http://www.geobasis.nrw.de'>Geobasis NRW</a>"
    clientOptions.hidden true
    withCache false
}

map.layers+ {
    title "basemap.de (WMTS)"
    type "wmts"
    provider.url "https://sgx.geodatenzentrum.de/wmts_basemapde/1.0.0/WMTSCapabilities.xml"
    sourceLayers.names ["de_basemapde_web_raster_farbe"]
    metadata.attribution "© <a href='https://basemap.de'>basemap.de</a> / BKG"
    clientOptions.hidden true
    withCache false
}

map.layers+ {
    title "Sentinel-2 (GeoTIFF)"
    type "raster"
    display "tile"
    provider.paths ["/gws-extern/demos/S2A_32ULB_20250811_TCI.tif"]
    metadata.attribution "Contains modified Copernicus Sentinel data 2025"
    clientOptions.hidden true
    withCache false
}

{demo_osm_background}

printers+ {
    title "A4"
    template {
       type "html"
       text """
            @@page width="297" height="210" margin="5"
            <center>
            <h1>A4 - {{dpi}} dpi</h1>
            @@map
            </center>
       """
       mapSize [ "280mm" "180mm" ]
   }
   qualityLevels [
       { dpi  90 name "screen" }
       { dpi 150 name "gut" }
       { dpi 300 name "hoch" }
   ]
}
printers+ {
   title "A2"
   template {
       type "html"
       text """
            @@page width="594" height="420" margin="5"
            <center>
            <h1>A2 - {{dpi}} dpi</h1>
            @@map
            </center>
       """
       mapSize [ "560mm" "400mm" ]
   }
   qualityLevels [
       { dpi  90 name "screen" }
       { dpi 150 name "gut" }
       { dpi 300 name "hoch" }
   ]
}
