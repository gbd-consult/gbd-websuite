uid "service_wms_simple_demo"

title "WMS Dienst, einfach"

metadata.keywords [ "ows-dienste" "wms" ]

metadata.abstract """
Ein einfacher, von der WebSuite bereitgestellter WMS-Dienst mit einem OpenStreetMap-Layer.

Der Dienst kann über die Service-URL in einer externen Anwendung wie QGIS eingebunden werden; das Demo-QGIS-Projekt enthält die Dienste bereits.

Konfiguriert ist ein `owsServices`-Eintrag vom Typ `wms` mit Angaben für das Capabilities-Dokument in `metadata`. Veröffentlicht wird der Kachellayer der Projektkarte (`type "tile"`), dessen statische Legende (`legend.type "static"`) über `GetLegendGraphic` abrufbar ist. `map.extent` begrenzt den Bereich des Dienstes auf die Umgebung von Düsseldorf.

[Service URL](/_/owsService/serviceUid/service_wms_simple?request=GetCapabilities)

[Demo QGIS Project](/ows_services.qgs)
"""

owsServices+ {
    type "wms"
    uid "service_wms_simple"
    metadata {
        abstract "Simple WMS service"
        keywords ["test" "wms" "demo"]
        name "SIMPLE_WMS"
        title "Simple WMS"
        catalogUid "ows_service_wms_simple"
        {demo_metadata}
    }
}

map.extent [
    {demo_point_duesseldorf_3857[0] - 30000}
    {demo_point_duesseldorf_3857[1] - 30000}
    {demo_point_duesseldorf_3857[0] + 30000}
    {demo_point_duesseldorf_3857[1] + 30000}
]

map.layers+ {
    title "Open Street Map"
    type "tile"
    provider.url "https://geoservices.gbd-consult.de/xyz/light/{{z}}/{{x}}/{{y}}.png?key=gwsdemo"

    withCache true

    legend {
        type "static"
        path "osm_legend.png"
    }

}
