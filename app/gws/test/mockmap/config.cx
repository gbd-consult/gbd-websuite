@# mockmap example configuration
@#
@# jump templating is applied before slon parsing, so values can be computed.
@# note: "{" must be followed by whitespace, otherwise it starts an echo.

@let crs32 = 25832
@let crsWM = 3857
@let crsSA = 31983

@# grid: a metric tile grid for the given CRS. The frame is the CRS extent,
@# level 0 is a single tile across the frame width, levels run down to gridMinRes.
@#
@# EPSG:3857 is the exception: XYZ carries no grid metadata, so clients assume
@# the de-facto slippy-map frame, a square. That is a convention, not something
@# derivable from the CRS, whose own extent spans latitude +-85.06 degrees.

@let gridTileSize = 256
@let gridMinRes = 1.0
@let webmercatorSquare = 20037508.342789244

@def grid crs origin
    @let ext = gws.lib.crs.require(crs).extent
    @let x0 = ext[0]
    @let y0 = ext[1]
    @let x1 = ext[2]
    @let y1 = ext[3]
    @if crs == 3857
        @let x0 = -webmercatorSquare
        @let y0 = -webmercatorSquare
        @let x1 = webmercatorSquare
        @let y1 = webmercatorSquare
    @end
    @let res0 = (x1 - x0) / gridTileSize
    tmsExtent [ {x0} {y0} {x1} {y1} ]
    tileSize {gridTileSize}
    origin "{origin}"
    resolutions [
        @for z in range(32)
            @let res = res0 / (2 ** z)
            @if res < gridMinRes
                @break
            @end
            {res}
        @end
    ]
@end

default {
    layer "map"
    overlay false
    overlayTile true

    extent [ -25 34 45 72 ]
    step 1.0
    graticule true
    checker true
    shapes true
    labels true
    labelSize 9
    labelPad 0
    labelPartials false
    labelForce false
    background ""
}

@# 6. WMS

services+ {
    uid "wms_32"
    type "wms"
    version "1.3.0"
    crs {crs32}
}

services+ {
    uid "wms_84"
    type "wms"
    version "1.3.0"
    crs 4326
}

services+ {
    uid "wms_84_111"
    type "wms"
    version "1.1.1"
    crs 4326
}

@# a projection with nothing in common with the others: southern hemisphere,
@# 10000000 false northing, and an area of use on another continent

services+ {
    uid "wms_sa"
    type "wms"
    version "1.3.0"
    crs {crsSA}
}

@# 3. WMTS KVP

services+ {
    uid "wmts_32"
    type "wmts"
    crs {crs32}
    @grid crs32 "nw"
}

@# 4. WMTS RESTful

services+ {
    uid "wmtsr_32"
    type "wmts_rest"
    crs {crs32}
    @grid crs32 "nw"
}

@# 1. XYZ

services+ {
    uid "xyz_3857"
    type "xyz"
    crs {crsWM}
    @grid crsWM "nw"
}

@# 2. TMS - disabled: the GWS tile provider is XYZ-only and renders a
@# sw-origin source mirrored. See grabber spec 12.2.
@#
@# services+ {
@#     uid "tms_3857"
@#     type "tms"
@#     crs {crsWM}
@#     @grid crsWM "sw"
@# }
