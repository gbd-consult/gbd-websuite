uid "field_file"

title "Editieren mit Datei als Attribut"

metadata.keywords [ "edit" "datenbank" ]

metadata.abstract """
Eine Datei als Attribut eines Objekts in der Datenbank speichern.

Im Reiter "Editieren" das Modell "Documents" wählen, ein Objekt öffnen oder mit "Neues Objekt über Formular erstellen" anlegen und im Feld "File" eine Datei hochladen.

Das Feld ist vom Typ `file`: `contentColumn "content"` speichert den Dateiinhalt in der Tabelle `edit.document`, `nameColumn "filename"` den Dateinamen. Das Modell hat keine Geometrie und ist auf Projektebene unter `models` definiert.
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }


map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}

models+ {
    type "postgres"
    uid "model_file_001"
    tableName "edit.document"
    sort+ { fieldName "filename" }
    title "Documents"
    permissions.edit "allow all"
    isEditable true

    fields+ { name "id" type "integer" title "Identifier" isPrimaryKey true permissions.edit "deny all" }
    fields+ { name "filename" type "text" title "File name" isRequired false  textSearch { type "any" } }

    fields+ {
        name "file"
        title "File"
        type "file"
        contentColumn "content"
        nameColumn "filename"
    }

    templates+ {
        subject "feature.title"
        type "html"
        text "{{@if feature.isNew}} New {{@else}} {{filename}} {{@end}}"
    }
}

{demo_osm_background}
