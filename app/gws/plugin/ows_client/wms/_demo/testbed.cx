uid "wms_testbed"

title "WMS Testumgebung, mehrere Dienste"

metadata.keywords [ "wms" "karte" ]

metadata.abstract """
Testprojekt mit WMS-Diensten verschiedener Anbieter als Layerbäume: ALKIS NRW, Karten der Hessischen Verwaltung für Bodenmanagement und Geoinformation und Verwaltungsgebiete 1:5.000.000 des BKG.

Beim Start ist nur der BKG-Dienst sichtbar. Die beiden anderen Dienste sind mit `clientOptions.hidden true` ausgeblendet und können im Layer-Panel eingeschaltet werden; der ALKIS-Dienst zeigt seine Daten erst in großen Maßstäben.

Alle Dienste sind als Layer vom Typ `wms` eingebunden. Beim BKG-Dienst schließt `excludeLayers.titles` die Quelllayer „Verwaltungsgemeinschaft“ und „Gemeinde“ anhand ihrer Titel aus dem Layerbaum aus. `map.extent` begrenzt die Karte auf die Ausdehnung Deutschlands.
"""

map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 4_000_000
    @# SELECT ST_EXTENT(ST_TRANSFORM(geom, 3857)) FROM ne_10m_admin_0_countries WHERE name='Germany'
    extent [ 651496 5986440 1672247 7374556 ]
}

map.layers+ {
    type "wms"
    title "NRW ALKIS"
    provider.url "https://www.wms.nrw.de/geobasis/wms_nw_alkis"
    metadata.attribution "© Geobasis NRW"
    clientOptions.hidden true
}

map.layers+ {
    type "wms"
    title "WMS HE Karten"
    provider.url "https://www.gds-srv.hessen.de/cgi-bin/lika-services/ogc-free-maps.ows"
    metadata.attribution "© Hessische Verwaltung für Bodenmanagement und Geoinformation"
    clientOptions.hidden true
}

map.layers+ {
    type "wms"
    title "BKG Verwaltungsgebiete"
    provider.url "https://sgx.geodatenzentrum.de/wms_vg5000_0101"
    metadata.attribution "© GeoBasis-DE / BKG (2024)"
    excludeLayers.titles [ "Verwaltungsgemeinschaft"  "Gemeinde" ]
}

{demo_osm_background}
