    <maplayer type="vector" geometry="Point">
      <id>missing_L8</id>
      <datasource>service='{PG_SERVICE}' sslmode=disable key='id' srid=3857 type=Point table="qfc"."no_such_table" (geom)</datasource>
      <provider encoding="UTF-8">postgres</provider>
      <layername>Missing table</layername>
      <srs>
        <spatialrefsys>
          <authid>EPSG:3857</authid>
          <srid>3857</srid>
        </spatialrefsys>
      </srs>
      <customproperties>
        <Option type="Map">
          <Option value="offline" type="QString" name="QFieldSync/cloud_action"/>
        </Option>
      </customproperties>
    </maplayer>

  </projectlayers>

  <visibility-presets>
    <visibility-preset name="BaseMapTheme">
      <layer id="wms_L6" visible="1" style=""/>
      <layer id="poi_L1" visible="0" style=""/>
    </visibility-preset>
  </visibility-presets>

  <properties>
    <WMSExtent type="QStringList">
      <value>740000</value>
      <value>6640000</value>
      <value>760000</value>
      <value>6660000</value>
    </WMSExtent>
    <Paths>
      <Absolute type="bool">true</Absolute>
    </Paths>
    <qfieldsync>
      <areaOfInterest type="QString">Polygon ((744000 6644000, 754000 6644000, 754000 6654000, 744000 6654000, 744000 6644000))</areaOfInterest>
      <areaOfInterestCrs type="QString">EPSG:3857</areaOfInterestCrs>
      <baseMapLayer type="QString">basemap_L9</baseMapLayer>
      <baseMapTheme type="QString">BaseMapTheme</baseMapTheme>
      <baseMapTileSize type="int">1024</baseMapTileSize>
      <baseMapTilesMaxZoomLevel type="int">12</baseMapTilesMaxZoomLevel>
      <baseMapTilesMinZoomLevel type="int">12</baseMapTilesMinZoomLevel>
