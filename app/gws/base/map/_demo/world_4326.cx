uid "map_world_4326"

title "World WGS"

metadata.keywords [ "map" "crs" ]

metadata.abstract """
Whole world map in EPSG:4326.
"""

map {
    crs 4326
    center [0 0]
    zoom.scales [44500000 33400000 22300000 11100000 5600000 2200000 1100000 560000]
    zoom.initScale 33400000
    wrapX true
}

map.layers+ {
    title "Countries (Natural Earth)"
    type "postgres"
    tableName "public.ne_10m_admin_0_countries"
    metadata.attribution "Made with Natural Earth"
    cssSelector ".ne_countries"
}

{demo_osm_background}
