uid "value_format"

title "Editieren mit Feldwert aus Vorlage"

metadata.keywords [ "edit" "datenbank" ]

metadata.abstract """
Ein Feld, dessen Vorgabewert aus anderen Attributen des Objekts zusammengesetzt wird.

Im Reiter "Editieren" das Modell "Districts" wählen und einen Stadtteil öffnen. Ist das Feld "Description" leer, wird es mit einem Text aus Name und Kennung vorbelegt, der weiter bearbeitet werden kann.

Die Wertquelle `type "format"` bildet den Text aus der Vorlage `format`, in die die Attribute `name` und `sid` in doppelten geschweiften Klammern eingesetzt werden. Mit `isDefault true` wird der Wert nur verwendet, wenn das Feld keinen anderen Wert hat.
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }


map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}

models+ {
    title "Districts"
    type "postgres"
    tableName "edit.district"
    isEditable true
    permissions.edit 'allow all'
    fields+ {
        name "sid"
        type "text"
        title "Identifier"
        isPrimaryKey true
        permissions.edit "deny all"
    }

    fields+ {
        name "name"
        type "text"
        title "Object name"
    }

    fields+ {
        name "description"
        type "text"
        title "Description"
        widget.type "textarea"
        values+ {
            type "format"
            isDefault true
            format "TODO: write description for {{name}} (id={{sid}})"
        }
    }

    templates+ { subject "feature.label" type "html" text "{{name}}" }
    templates+ { subject "feature.title" type "html" text "{{name}}" }

}

map.layers+ {
    title "Districts"
    type "postgres"
    tableName "edit.district"
}

{demo_osm_background}
