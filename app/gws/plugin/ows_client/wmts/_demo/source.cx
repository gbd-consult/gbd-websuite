uid "wmts_source"

title "WMTS Layer mit Quelllayer-Auswahl"

metadata.keywords [ "wmts" "karte" ]

metadata.abstract """
Mehrere Layer desselben WMTS-Dienstes als umschaltbare Varianten: drei Stile des Stadtplanwerks Ruhrgebiet.

Im Layer-Panel ist die Gruppe „Stadtplanwerk Ruhrgebiet“ aufgeklappt. Von ihren Layern „Light“, „Extra Light“ und „Orange“ ist immer nur einer sichtbar; beim Einschalten eines Layers wird der vorher sichtbare ausgeschaltet.

Jeder Layer ist vom Typ `wmts` mit derselben `provider.url` und wählt mit `sourceLayers.names` einen anderen Quelllayer des Dienstes aus. Die Gruppe (`type "group"`) hat `clientOptions {{ exclusive true expanded true }}`; `exclusive` lässt nur einen sichtbaren Unterlayer zu. Die beiden zunächst nicht sichtbaren Layer sind mit `clientOptions.hidden true` ausgeblendet. `withCache true` speichert die Kacheln auf dem Server zwischen.
"""

map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 70000
}

map.layers+ {
    type "group"
    title "Stadtplanwerk Ruhrgebiet"
    clientOptions { exclusive true expanded true }
    layers [
        {
            type "wmts"
            title "Light"
            provider.url "https://geodaten.metropoleruhr.de/spw2"
            sourceLayers.names [ "spw2_light_plus" ]
            withCache true
        }
        {
            type "wmts"
            title "Extra Light"
            provider.url "https://geodaten.metropoleruhr.de/spw2"
            sourceLayers.names [ "spw2_extralight_plus" ]
            withCache true
            clientOptions.hidden true
        }
        {
            type "wmts"
            title "Orange"
            provider.url "https://geodaten.metropoleruhr.de/spw2"
            sourceLayers.names [ "spw2_orange_plus" ]
            withCache true
            clientOptions.hidden true
        }
    ]
}

{demo_osm_background}
