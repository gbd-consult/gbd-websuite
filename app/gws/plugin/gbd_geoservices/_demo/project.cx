uid "geoservices_search"

title "GBD Geoservices"

metadata.keywords [ "search" ]

metadata.abstract """
Volltextsuche mit [GBD Geoservices](https://geoservices.gbd-consult.de). 
Es wird in Schleswig-Holstein nach Orten, Straßen, Punkten von Interesse und Adressen gesucht.
"""

client.addElements+ { tag "Sidebar.Search" }
client.addElements+ { tag "Altbar.Search" }

client.options.sidebarActiveTab "Sidebar.Layers"

actions+ { type "search" tolerance "5px" }

finders+ {
    type "gbd_geoservices"
    apiKey "my_key"
    spatialContext "map"
}

map {
    center [1163289, 6649645]
    extent [612257, 5942074, 1725452, 7420309]
    zoom.initScale 5000000
    zoom.maxScale 5000000
    zoom.minScale  50
}

@let DETAILS = {
    "_max": "Karte Erweitert",
    "": "Karte Standard",
    "_min": "Karte Einfach",
}

@let THEMES = {
    "default": "Default",
    "light": "Hell",
    "dark": "Dunkel",
    "hico": "Kontrast",
}

@for detail, detail_label in DETAILS
    map.layers+ {
        title "{detail_label}"
        type "group"
        clientOptions.expanded {detail == ""}
        clientOptions.exclusive true
        clientOptions.hidden {detail != ""}

        @for theme, theme_label in THEMES
            layers+ {
                title "{theme_label}"
                type "tile"
                display "client"
                clientOptions.hidden {theme != "default"}
                provider.url "https://geoservices.gbd-consult.de/xyz/{theme}{detail}/{{z}}/{{x}}/{{y}}.png?key=my_key"
                metadata.attribution "© <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"
            }
        @end
    }
@end
