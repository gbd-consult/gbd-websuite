class User(Object):
    """User.

    A user has a set of roles, which are checked against the permissions of
    objects to decide access.
    """

    isGuest: bool
    """The user is the guest user."""

    authProvider: 'AuthProvider'
    """The provider that created the user."""

    attributes: dict
    """Public user attributes, sent to the client."""
    data: dict
    """Private user data from the provider."""
    roles: set[str]
    """User roles."""
    uid: str
    """Global user uid, made of the provider uid and the local uid."""

    authToken: str
    """Token for the ``token`` authentication method."""
    displayName: str
    """User display name."""
    email: str
    """User email."""
    localUid: str
    """User uid within its provider."""
    loginName: str
    """User login name."""
    mfaUid: str
    """Uid of the multi-factor adapter for this user, empty if none."""
    mfaSecret: str
    """Secret for the multi-factor adapter."""

    def acl_bit(self, access: Access, obj: Object) -> Optional[int]:
        """Get the access decision for an object itself, without parents.

        Args:
            access: Access mode.
            obj: The object.

        Returns:
            ``gws.c.ALLOW`` or ``gws.c.DENY`` if the object's permissions decide
            for one of the user's roles, ``None`` otherwise.
        """

    def can(self, access: Access, obj: Object, *context) -> bool:
        """Check if the user can access an object.

        If the object's permissions do not decide, the context objects are
        checked in turn, then the parents of the last checked object.

        Args:
            access: Access mode.
            obj: The object.
            *context: Further objects to check, before the parents.

        Returns:
            ``True`` if access is granted.
        """

    def can_create(self, obj: Object, *context) -> bool:
        """Check if the user has the ``create`` permission on an object.

        Args:
            obj: The object.
            *context: Further objects to check, before the parents.

        Returns:
            ``True`` if access is granted.
        """

    def can_delete(self, obj: Object, *context) -> bool:
        """Check if the user has the ``delete`` permission on an object.

        Args:
            obj: The object.
            *context: Further objects to check, before the parents.

        Returns:
            ``True`` if access is granted.
        """

    def can_read(self, obj: Object, *context) -> bool:
        """Check if the user has the ``read`` permission on an object.

        Args:
            obj: The object.
            *context: Further objects to check, before the parents.

        Returns:
            ``True`` if access is granted.
        """

    def can_use(self, obj: Object, *context) -> bool:
        """Check if the user can use an object, which requires the ``read`` permission.

        Args:
            obj: The object.
            *context: Further objects to check, before the parents.

        Returns:
            ``True`` if access is granted.
        """

    def can_write(self, obj: Object, *context) -> bool:
        """Check if the user has the ``write`` permission on an object.

        Args:
            obj: The object.
            *context: Further objects to check, before the parents.

        Returns:
            ``True`` if access is granted.
        """

    def can_edit(self, obj: Object, *context) -> bool:
        """Check if the user has any of the ``write``, ``create`` or ``delete`` permissions on an object.

        Args:
            obj: The object.
            *context: Further objects to check, before the parents.

        Returns:
            ``True`` if access is granted.
        """

    def has_role(self, role: str) -> bool:
        """Check if the user has a role.

        Args:
            role: Role name.

        Returns:
            ``True`` if the user has the role.
        """

    def acquire(self, uid: str = None, classref: Optional[ClassRef] = None, access: Optional[Access] = None) -> Optional[Object]:
        """Get an object by uid, if the user can access it.

        Args:
            uid: Object uid.
            classref: Class reference. If provided, the object must match it.
            access: Access mode, ``Access.read`` if omitted.

        Returns:
            The object, or ``None`` if it does not exist or the user may not access it.
        """

    def require(self, uid: str = None, classref: Optional[ClassRef] = None, access: Optional[Access] = None) -> Object:
        """Get an object by uid and fail if it is not found or not accessible.

        Args:
            uid: Object uid.
            classref: Class reference. If provided, the object must match it.
            access: Access mode, ``Access.read`` if omitted.

        Returns:
            The object.

        Raises:
            NotFoundError: If the object does not exist.
            ForbiddenError: If the user may not access the object.
        """

    def require_project(self, uid: str = None) -> 'Project':
        """Get a project the user can read.

        Args:
            uid: Project uid.

        Returns:
            The project.

        Raises:
            NotFoundError: If the project does not exist.
            ForbiddenError: If the user may not read the project.
        """

    def require_layer(self, uid=None) -> 'Layer':
        """Get a layer the user can read.

        Args:
            uid: Layer uid.

        Returns:
            The layer.

        Raises:
            NotFoundError: If the layer does not exist.
            ForbiddenError: If the user may not read the layer.
        """


class AuthManager(Node):
    """Authorization manager.

    Holds the authentication methods, providers, multi-factor adapters and the
    session manager, authenticates users and opens a session for every web request.
    """

    guestSession: 'AuthSession'
    """Session of the guest user, used for requests without a session."""

    guestUser: 'User'
    """The guest user."""
    systemUser: 'User'
    """The system user, allowed everything."""

    providers: list['AuthProvider']
    """Authentication providers."""
    methods: list['AuthMethod']
    """Authentication methods."""
    mfAdapters: list['AuthMultiFactorAdapter']
    """Multi-factor adapters."""

    sessionMgr: 'AuthSessionManager'
    """Session manager."""

    def authenticate(self, method: 'AuthMethod', credentials: Data, req: 'WebRequester') -> Optional['User']:
        """Authenticate a user with the providers that allow the method.

        Args:
            method: The authentication method.
            credentials: The credentials, for example ``username`` and ``password``.
            req: The web request.

        Returns:
            The user, or ``None`` if no provider accepts the credentials.

        Raises:
            ForbiddenError: If a provider rejects the credentials.
            TooManyRequestsError: If the attempt is blocked by the throttle.
        """

    def create_transient_session(self, method: 'AuthMethod', user: 'User', data: Optional[dict] = None) -> 'AuthSession':
        """Create a session that lives only for the duration of the request.

        The session is not stored in the session manager.

        Args:
            method: The method that creates the session.
            user: The session user.
            data: Session data.

        Returns:
            A new session.
        """

    def get_user(self, user_uid: str) -> Optional['User']:
        """Get a user by its global uid.

        Args:
            user_uid: Global user uid.

        Returns:
            The user, or ``None`` if the provider is not found or does not return the user.
        """

    def add_provider(self, provider: 'AuthProvider'):
        """Add an authentication provider.

        Args:
            provider: The provider.
        """

    def add_method(self, method: 'AuthMethod'):
        """Add an authentication method.

        Args:
            method: The method.
        """

    def add_multi_factor_adapter(self, adapter: 'AuthMultiFactorAdapter'):
        """Add a multi-factor adapter.

        Args:
            adapter: The adapter.
        """

    def can_use_method(self, req: 'WebRequester', method: 'AuthMethod') -> bool:
        """Check if a method may be used for a request.

        A secure method can only be used on secure requests, or from the addresses
        listed in its ``allowInsecureFrom``.

        Args:
            req: The web request.
            method: The method.

        Returns:
            ``True`` if the method may be used.
        """

    def get_provider(self, uid: str) -> Optional['AuthProvider']:
        """Get an authentication provider by its uid.

        Args:
            uid: Provider uid.

        Returns:
            The provider, or ``None`` if not found.
        """

    def get_method(self, uid: str) -> Optional['AuthMethod']:
        """Get an authentication method by its uid.

        Args:
            uid: Method uid.

        Returns:
            The method, or ``None`` if not found.
        """

    def get_multi_factor_adapter(self, uid: str) -> Optional['AuthMultiFactorAdapter']:
        """Get a multi-factor adapter by its uid.

        Args:
            uid: Adapter uid.

        Returns:
            The adapter, or ``None`` if not found.
        """

    def serialize_user(self, user: 'User') -> str:
        """Serialize a user to a string, together with its provider uid.

        Args:
            user: The user.

        Returns:
            A JSON string.
        """

    def unserialize_user(self, ser: str) -> Optional['User']:
        """Restore a user serialized by ``serialize_user``.

        Args:
            ser: The serialized user.

        Returns:
            The user, or ``None`` if the provider is not found.
        """

    def is_public_object(self, obj: Object, *context) -> bool:
        """Check if the guest user can read an object.

        Args:
            obj: The object.
            *context: Further objects to check, before the parents.

        Returns:
            ``True`` if the object is public.
        """


class AuthMethod(Node):
    """Authentication method.

    Defines how credentials and sessions are passed between the client and the
    server, for example as a login form and a session cookie.
    """

    secure: bool
    """The method may only be used on secure (HTTPS) requests."""

    allowInsecureFrom: list[str]
    """IP addresses from which the method may be used without HTTPS."""

    def open_session(self, req: 'WebRequester') -> Optional['AuthSession']:
        """Try to open a session for a request.

        Called at the start of every web request.

        Args:
            req: The web request.

        Returns:
            A session, or ``None`` if the request has no session for this method.
        """

    def close_session(self, req: 'WebRequester', res: 'WebResponder') -> None:
        """Close the session of a request.

        Called at the end of every web request whose session was opened by this
        method, for example to set or delete the session cookie.

        Args:
            req: The web request.
            res: The web response.
        """


class AuthMultiFactorState(Enum):
    """State of a multi-factor authentication transaction."""

    open = 'open'
    """The transaction is started and waits for verification."""
    ok = 'ok'
    """The verification was successful."""
    retry = 'retry'
    """The verification failed and can be retried."""
    failed = 'failed'
    """The transaction failed."""


class AuthMultiFactorTransaction(Data):
    """Multi-factor authentication transaction.

    Kept in the user's session from the login until the verification succeeds,
    fails or expires.
    """

    state: AuthMultiFactorState
    """Current state."""
    restartCount: int
    """Number of restarts."""
    verifyCount: int
    """Number of verification attempts."""
    secret: str
    """Secret for code generation."""
    startTime: int
    """Start time, as a Unix timestamp."""
    generateTime: int
    """Time when the code was last generated, as a Unix timestamp."""
    message: str
    """Message shown to the user."""
    adapter: 'AuthMultiFactorAdapter'
    """The adapter handling the transaction."""
    user: 'User'
    """The user who logs in."""


class AuthMultiFactorAdapter(Node):
    """Multi-factor authentication adapter.

    Provides the second verification step of a login, for example a code sent by
    email or generated by an authenticator app.
    """

    message: str
    """Message shown to the user during the verification step."""
    lifeTime: int
    """Time in seconds allowed to complete the verification."""
    maxRestarts: int
    """How often a transaction can be restarted."""
    maxVerifyAttempts: int
    """Number of verification attempts allowed."""

    def start(self, user: 'User') -> Optional[AuthMultiFactorTransaction]:
        """Start a transaction for a user.

        Args:
            user: The user who logs in.

        Returns:
            A new transaction, or ``None`` if the adapter cannot be used for this
            user, for example because a required user attribute is missing.
        """

    def verify(self, mfa: AuthMultiFactorTransaction, payload: dict) -> AuthMultiFactorTransaction:
        """Verify a payload submitted by the user.

        Args:
            mfa: The transaction.
            payload: The payload, for example ``{'code': '123456'}``.

        Returns:
            The transaction with an updated state.
        """

    def check_state(self, mfa: AuthMultiFactorTransaction) -> bool:
        """Check if a transaction is still valid, and mark it failed if not.

        Args:
            mfa: The transaction.

        Returns:
            ``True`` if the transaction is valid.
        """

    def check_restart(self, mfa: AuthMultiFactorTransaction) -> bool:
        """Check if a transaction can be restarted.

        Args:
            mfa: The transaction.

        Returns:
            ``True`` if a restart is allowed.
        """

    def restart(self, mfa: AuthMultiFactorTransaction) -> Optional[AuthMultiFactorTransaction]:
        """Restart a transaction, for example by sending a new code.

        Args:
            mfa: The transaction.

        Returns:
            A new transaction, or ``None`` if a restart is not possible.
        """

    def key_uri(self, secret: str | bytes, issuer_name: str, account_name: str) -> Optional[str]:
        """Generate a key URI for authenticator apps.

        Args:
            secret: The user's secret.
            issuer_name: Issuer name shown in the app.
            account_name: Account name shown in the app.

        Returns:
            An ``otpauth://`` URI, or ``None`` if the adapter does not support it.
        """


class AuthProvider(Node):
    """Authentication provider.

    A source of users, for example a file, an LDAP directory or a database table,
    which verifies credentials.
    """

    allowedMethods: list[str]
    """Method types this provider accepts, all methods if empty."""

    def get_user(self, local_uid: str) -> Optional['User']:
        """Get a user by its local uid.

        Args:
            local_uid: User uid within the provider.

        Returns:
            The user, or ``None`` if not found.
        """

    def authenticate(self, method: 'AuthMethod', credentials: Data) -> Optional['User']:
        """Authenticate a user.

        Args:
            method: The authentication method.
            credentials: The credentials, for example ``username`` and ``password``.

        Returns:
            The user, or ``None`` if the provider does not know the user.

        Raises:
            AuthenticationError: If the credentials are wrong or match more than one user.
        """

    def serialize_user(self, user: 'User') -> str:
        """Serialize a user to a string.

        Args:
            user: The user.

        Returns:
            The serialized user.
        """

    def unserialize_user(self, ser: str) -> Optional['User']:
        """Restore a user serialized by ``serialize_user``.

        Args:
            ser: The serialized user.

        Returns:
            The user, or ``None`` if it cannot be restored.
        """


class AuthSession:
    """Authentication session.

    Holds the user and arbitrary data between requests.
    """

    uid: str
    """Session uid."""
    method: Optional['AuthMethod']
    """The method that created the session, ``None`` for the guest session."""
    user: 'User'
    """The session user."""
    data: dict
    """Session data."""
    created: 'datetime.datetime'
    """Creation time."""
    updated: 'datetime.datetime'
    """Last update time."""
    isChanged: bool
    """The session data has changed since the session was loaded."""
    isTransient: bool
    """The session lives only for the duration of the request and is not stored."""

    def get(self, key: str, default=None):
        """Get a session data value.

        Args:
            key: Value name.
            default: Default value.

        Returns:
            The value, or the default if it is not set.
        """

    def set(self, key: str, value):
        """Set a session data value and mark the session as changed.

        Args:
            key: Value name.
            value: The value.
        """


class AuthSessionManager(Node):
    """Authentication session manager.

    Stores sessions persistently. A session is valid until ``lifeTime`` has passed
    since its last update, or ``maxLifeTime`` since its creation.
    """

    lifeTime: int
    """Session life time in seconds, counted from the last update."""

    maxLifeTime: int
    """Absolute session life time in seconds, counted from the creation, or 0 if not limited."""

    def create(self, method: 'AuthMethod', user: 'User', data: Optional[dict] = None) -> 'AuthSession':
        """Create and store a new session.

        Args:
            method: The method that creates the session.
            user: The session user.
            data: Session data.

        Returns:
            The new session.
        """

    def delete(self, sess: 'AuthSession'):
        """Delete a session.

        Args:
            sess: The session.
        """

    def delete_all(self):
        """Delete all sessions."""

    def get(self, uid: str) -> Optional['AuthSession']:
        """Get a valid session by its uid.

        Args:
            uid: Session uid.

        Returns:
            The session, or ``None`` if it does not exist or has expired.
        """

    def list_all(self) -> list['AuthSession']:
        """Get all stored sessions.

        Returns:
            A list of sessions.
        """

    def save(self, sess: 'AuthSession'):
        """Save the session data.

        Args:
            sess: The session.
        """

    def touch(self, sess: 'AuthSession'):
        """Update the last activity time of a session.

        Args:
            sess: The session.
        """

    def cleanup(self):
        """Remove expired sessions from the storage."""
