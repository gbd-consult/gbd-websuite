uid "alkis_ui"

title "ALKIS Flurstückssuche, erweiterte Oberfläche"

metadata.keywords [ "alkis" "suche" ]

metadata.abstract """
ALKIS Flurstückssuche mit allen wesentlichen Bedienoptionen und der Standard-Export-Konfiguration.

Im Seitenleisten-Reiter der Flurstückssuche stehen zusätzlich zur Formularsuche die räumliche Suche mit einer auf der Karte gezeichneten Fläche, das Auswählen einzelner Flurstücke in der Karte, eine Auswahlliste und der Export der Treffer zur Verfügung.

Die Optionen werden unter `ui` der Aktion `alkis` freigeschaltet:

- `useSelect`: Auswahlliste für Flurstücke
- `usePick`: Flurstücke durch Klick in die Karte wählen
- `useExport`: Export; ohne `exporters` wird eine Standard-Konfiguration verwendet
- `searchSpatial`: räumliche Suche mit gezeichneter Suchfläche
- `gemarkungListMode "tree"`: Gemarkungen als Baum unter ihrer Gemeinde
- `strasseListMode "withGemarkung"`: Straßen mit Gemarkung in Klammern

`limit 200` begrenzt die Zahl der Treffer.
"""

actions+ {
    type "alkis"
    dbUid "DB_ALKIS"
    dataSchema "public"
    indexSchema "gws82"
    crs 25832

    limit 200

    ui {
        useSelect true
        usePick true
        useExport true
        searchSpatial true
        gemarkungListMode "tree"
        strasseListMode "withGemarkung"
    }
}

client.addElements+ { tag "Sidebar.Alkis" }
client.options.sidebarWidth 400

map {
    center {demo_point_kamen_25832}
    crs 25832
    zoom.initScale 4000
    zoom.maxScale  50000
}

map.layers+ {
    title "NRW ALKIS"
    type "wmsflat"
    provider.url "https://www.wms.nrw.de/geobasis/wms_nw_alkis"
    sourceLayers.names [ "adv_alkis_flurstuecke" ]
    metadata.attribution "&copy; <a href='http://www.geobasis.nrw.de'>Geobasis NRW</a>"
}

{demo_osm_background}
