class Object:
    """Basic GWS object.

    An object has permissions and can provide properties for the client.
    """

    permissions: dict[Access, Acl]
    """Mapping from an access mode to a list of ACL tuples."""

    def props(self, user: 'User') -> Props:
        """Generate a ``Props`` struct for this object.

        Do not call this method directly, use ``gws.props_of`` instead, which also checks permissions.

        Args:
            user: The user for which the props should be generated.

        Returns:
            A ``Props`` object or a dict. Nested objects are converted to props as well.
        """

    def __init__(self):
        self.permissions = {}


from .core import tree_impl

setattr(tree_impl, 'Access', Access)
setattr(tree_impl, 'Error', Error)
setattr(tree_impl, 'Data', Data)
setattr(tree_impl, 'Props', Props)
setattr(tree_impl, 'Object', Object)

Object.__repr__ = tree_impl.object_repr


class Node(Object):
    """GWS object tree node.

    Nodes are created by the ``Root`` or by their parent node. Configuration hooks
    (``pre_configure``, ``configure``, ``post_configure``) are invoked for every class in the MRO
    that defines them, base classes first, so they do not need to call ``super()``.
    """

    extName: str
    """Full extension name like ``gws.ext.object.layer.wms``."""
    extType: str
    """Extension type like ``wms``."""

    config: Config
    """Configuration for this object."""
    root: 'Root'
    """Root object."""
    parent: 'Node'
    """Parent object."""
    children: list['Node']
    """Child objects."""
    uid: str
    """Unique ID."""

    def initialize(self, config):
        """Initialize the node.

        Store the configuration, set up the permissions, then run ``pre_configure`` and ``configure``.

        Args:
            config: Configuration.
        """
        return tree_impl.node_initialize(self, config)

    def pre_configure(self):
        """Pre-configuration hook.

        Called before ``configure``, when the node is initialized.
        """

    def configure(self):
        """Configuration hook.

        Called when the node is initialized. Raising an exception here aborts the creation of the node.
        """

    def post_configure(self):
        """Post-configuration hook.

        Called after the whole object tree has been created.
        """

    def activate(self):
        """Activation hook.

        Called by ``Root.activate`` after the configuration has been loaded.
        """

    def create_child(self, classref: ClassRef, config: Config = None, **kwargs) -> Optional['Node']:
        """Create a child object.

        Args:
            classref: Class reference.
            config: Configuration.
            **kwargs: Additional configuration properties.

        Returns:
            A newly created object or ``None`` if the object cannot be initialized.
        """
        return tree_impl.node_create_child(self, classref, config, **kwargs)

    def create_child_if_configured(self, classref: ClassRef, config=None, **kwargs) -> Optional['Node']:
        """Create a child object if the configuration is not None.

        Args:
            classref: Class reference.
            config: Configuration.
            **kwargs: Additional configuration properties.

        Returns:
            A newly created object or ``None`` if the configuration is ``None`` or the object cannot be initialized.
        """
        return tree_impl.node_create_child_if_configured(self, classref, config, **kwargs)

    def create_children(self, classref: ClassRef, configs: list[Config], **kwargs) -> list['Node']:
        """Create a list of child objects from a list of configurations.

        Args:
            classref: Class reference.
            configs: List of configurations.
            **kwargs: Additional configuration properties.

        Returns:
            A list of newly created objects.
        """
        return tree_impl.node_create_children(self, classref, configs, **kwargs)

    def cfg(self, key: str, default=None):
        """Fetch a configuration property.

        Args:
            key: Property key. If it contains dots, fetch nested properties.
            default: Default to return if the property is not found.

        Returns:
            A property value.
        """
        return tree_impl.node_cfg(self, key, default)

    def is_a(self, classref: ClassRef) -> bool:
        """Check if the node matches the class reference.

        Args:
            classref: Class reference.

        Returns:
            ``True`` if the node matches.
        """
        return tree_impl.is_a(self.root, self, classref)

    def find_all(self, classref: Optional[ClassRef] = None) -> list['Node']:
        """Find all direct children that match a specific class.

        Args:
            classref: Class reference. If omitted, all children are returned.

        Returns:
            A list of objects.
        """
        return tree_impl.node_find_all(self, classref)

    def find_first(self, classref: Optional[ClassRef] = None) -> Optional['Node']:
        """Find the first direct child that matches a specific class.

        Args:
            classref: Class reference. If omitted, the first child is returned.

        Returns:
            An object or ``None``.
        """
        return tree_impl.node_find_first(self, classref)

    def find_closest(self, classref: Optional[ClassRef] = None) -> Optional['Node']:
        """Find the closest node ancestor that matches a specific class.

        Args:
            classref: Class reference. If omitted, the parent is returned.

        Returns:
            An object or ``None``.
        """

        return tree_impl.node_find_closest(self, classref)

    def find_ancestors(self, classref: Optional[ClassRef] = None) -> list['Node']:
        """Find node ancestors that match a specific class.

        Args:
            classref: Class reference. If omitted, all ancestors are returned.

        Returns:
            A list of objects, from the parent upwards.
        """
        return tree_impl.node_find_ancestors(self, classref)

    def find_descendants(self, classref: Optional[ClassRef] = None) -> list['Node']:
        """Find node descendants that match a specific class.

        Args:
            classref: Class reference. If omitted, all descendants are returned.

        Returns:
            A list of objects in the depth-first order.
        """

        return tree_impl.node_find_descendants(self, classref)

    def enter_middleware(self, req: 'WebRequester') -> Optional['WebResponder']:
        """Begin middleware processing.

        Args:
            req: Requester object.

        Returns:
            A Responder object to end the request processing, or ``None`` to continue.
        """

    def exit_middleware(self, req: 'WebRequester', res: 'WebResponder'):
        """Finish middleware processing.

        Args:
            req: Requester object.
            res: Current responder object.
        """

    def periodic_task(self):
        """Periodic task hook.

        Called by the server monitor for nodes registered with ``register_periodic_task``.
        """


class Root:
    """Root node of the object tree."""

    app: 'Application'
    """Application object."""
    specs: 'SpecRuntime'
    """Specs runtime."""
    configErrors: list
    """List of configuration errors."""
    configWarnings: list
    """List of configuration warnings."""

    nodes: list['Node']
    """All nodes in the tree, in the order of creation."""
    uidMap: dict[str, 'Node']
    """Mapping from uids to nodes."""
    uidCount: int
    """Counter for generated uids."""
    configStack: list['Node']
    """Nodes being configured, from the outermost to the current one."""
    configPaths: list[str]
    """Paths of the configuration files."""

    def __init__(self, specs: 'SpecRuntime'):
        """Create an empty root.

        Args:
            specs: Specs runtime.
        """
        tree_impl.root_init(self, specs)

    def initialize(self, obj, config):
        """Initialize a node and record configuration errors.

        Args:
            obj: The node.
            config: Configuration.

        Returns:
            ``True`` if the node was initialized, ``False`` if it failed.
        """
        return tree_impl.root_initialize(self, obj, config)

    def post_initialize(self):
        """Run ``post_configure`` on all nodes, in the reverse order of creation.

        Errors are logged and recorded in ``configErrors``.
        """
        return tree_impl.root_post_initialize(self)

    def activate(self):
        """Run ``activate`` on all nodes."""
        return tree_impl.root_activate(self)

    def config_warning(self, message: str):
        """Register a configuration warning.

        The warning is logged immediately and reported again after the configuration is complete.
        The object stack is only available when called from ``configure`` or ``post_configure``.

        Args:
            message: Warning message.
        """
        return tree_impl.root_config_warning(self, message)

    def find_all(self, classref: Optional[ClassRef] = None) -> list['Node']:
        """Find all objects that match a specific class.

        Args:
            classref: Class reference.

        Returns:
            A list of objects.
        """
        return tree_impl.root_find_all(self, classref)

    def find_first(self, classref: Optional[ClassRef] = None) -> Optional['Node']:
        """Find the first object that matches a specific class.

        Args:
            classref: Class reference.

        Returns:
            An object or ``None``.
        """
        return tree_impl.root_find_first(self, classref)

    def get(self, uid: str = None, classref: Optional[ClassRef] = None) -> Optional['Node']:
        """Get an object by its unique ID.

        Args:
            uid: Object uid.
            classref: Class reference. If provided, ensures that the object matches the reference.

        Returns:
            An object or ``None``.
        """
        return tree_impl.root_get(self, uid, classref)

    def object_count(self) -> int:
        """Return the number of objects in the tree.

        Returns:
            The number of objects.
        """
        return tree_impl.root_object_count(self)

    def create(
        self,
        classref: ClassRef,
        parent: Optional['Node'] = None,
        config: Config = None,
        **kwargs,
    ) -> Optional['Node']:
        """Create an object.

        Args:
            classref: Class reference.
            parent: Parent object.
            config: Configuration.
            **kwargs: Additional configuration properties.

        Returns:
            A newly created object or ``None`` if the object cannot be initialized.
        """
        return tree_impl.root_create(self, classref, parent, config, **kwargs)

    def create_shared(self, classref: ClassRef, config: Config = None, **kwargs) -> Optional['Node']:
        """Create a shared object, attached directly to the root.

        If the config has no uid, it is computed from the class reference and the configuration.
        If an object with this uid already exists, it is returned instead of creating a new one.

        Args:
            classref: Class reference.
            config: Configuration.
            **kwargs: Additional configuration properties.

        Returns:
            A newly created object or ``None`` if the object cannot be initialized.
        """
        return tree_impl.root_create_shared(self, classref, config, **kwargs)

    def create_temporary(self, classref: ClassRef, config: Config = None, **kwargs) -> Optional['Node']:
        """Create a temporary object, not attached to the tree.

        Args:
            classref: Class reference.
            config: Configuration.
            **kwargs: Additional configuration properties.

        Returns:
            A newly created object or ``None`` if the object cannot be initialized.
        """
        return tree_impl.root_create_temporary(self, classref, config, **kwargs)

    def create_application(self, config: Config = None, **kwargs) -> 'Application':
        """Create the Application object.

        Args:
            config: Configuration.
            **kwargs: Additional configuration properties.

        Returns:
            The Application object.
        """
        return tree_impl.root_create_application(self, config, **kwargs)


def create_root(specs: 'SpecRuntime') -> Root:
    """Create a new root object.

    Args:
        specs: Specs runtime.

    Returns:
        The root object.
    """
    return Root(specs)


def save_root(root: Root, path: str = None) -> str:
    """Pickle the root object to a file.

    ``sys.path`` is pickled next to it, to ``<path>.syspath``, so that ``load_root`` can restore it.

    Args:
        root: The root object.
        path: File path. Defaults to ``config.pickle`` in the config directory.

    Returns:
        The file path.
    """
    return tree_impl.save_root(root, path)


def load_root(path: str = None) -> Root:
    """Load a pickled root object, activate it and make it the current root.

    ``sys.path`` is restored first, so that plugin modules can be imported.

    Args:
        path: File path. Defaults to ``config.pickle`` in the config directory.

    Returns:
        The root object.
    """
    return tree_impl.load_root(path)


def activate_root(root: Root) -> Root:
    """Activate the root object and make it the current root.

    Args:
        root: The root object.

    Returns:
        The root object.
    """
    return tree_impl.activate_root(root)


def deactivate_root():
    """Remove the current root."""
    return tree_impl.deactivate_root()


def get_root() -> Root:
    """Return the current root object.

    Returns:
        The root object set by ``activate_root`` or ``load_root``.

    Raises:
        Error: If there is no current root.
    """
    return tree_impl.get_root()


def props_of(obj: Object, user: 'User', *context) -> Optional['Props']:
    """Generate props for an object, if the user is allowed to use it.

    Nested objects the user cannot read are removed from the result.

    Args:
        obj: The object.
        user: The user.
        *context: Context objects for the permission check.

    Returns:
        A ``Props`` object, or ``None`` if the user cannot use the object.

    Raises:
        Error: If the object's ``props`` returns an invalid type.
    """
    return tree_impl.props_of(obj, user, *context)
