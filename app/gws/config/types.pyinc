class ConfigLocation(Data):
    """Location in the configuration tree."""
    
    objectUid: str
    """UID of the object."""
    objectType: str
    """Type of the object."""
    objectName: str
    """Name of the object."""
    propName: str
    """Property of the parent this object is located at."""


class ConfigErrorInfo(Data):
    """Full information about a configuration error."""

    message: str
    """Error message."""
    path: str
    """Path to the configuration file."""
    line: int
    """Line number where the error occurred."""
    value: str
    """Value that caused the error."""
    stack: list[ConfigLocation]
    """Locations of the objects being configured when the error occurred, innermost first."""
    contextLines: list[str]
    """Source lines around the error, with line numbers, the error line is marked with ``>>>``."""
    cause: str
    """Representation of the exception that caused the error."""


class ConfigContext(Data):
    """Shared state for parsing and validating a configuration."""

    specs: SpecRuntime
    """Specs used to validate the configuration."""
    readOptions: set[SpecReadOption]
    """Options passed to the spec reader."""
    errors: list[ConfigErrorInfo]
    """Errors collected so far."""
    warnings: list[ConfigErrorInfo]
    """Warnings collected so far."""
    paths: set[str]
    """Paths of all configuration files that were read, including included files."""



class ConfigResult(Data):
    """Result of a configuration run."""

    root: Optional['Root']
    """Configured root object, or ``None`` if configuration failed or was not requested."""
    config: Optional['Config']
    """Parsed application configuration."""
    errors: list[ConfigErrorInfo]
    """Configuration errors."""
    warnings: list[ConfigErrorInfo]
    """Configuration warnings."""
    info: str
    """Summary with the number of objects, time and memory used."""
