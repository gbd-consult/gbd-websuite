uid "edit_users"

title "Editieren einer Tabelle ohne Geometrie"

metadata.keywords [ "edit" "datenbank" ]

metadata.abstract """
Bearbeiten einer PostgreSQL Tabelle ohne Geometrie, hier einer einfachen Nutzerliste.

Im Seitenleisten-Reiter "Editieren" das Modell "Nutzer" wählen. Da es nichts zu zeichnen gibt, werden neue Einträge mit "Neues Objekt über Formular erstellen" angelegt.

Das Modell ist auf Projektebene unter `models` definiert und gehört zu keinem Layer. Die Felder sind einzeln konfiguriert; `textSearch` an `nachname` macht die Liste durchsuchbar, die Vorlage `feature.title` zeigt "Nachname, Vorname".

Die Tabelle `edit.nutzer` dient in der Demo [Benutzerkonten in PostgreSQL verwalten](/project/account_admin) auch als Kontentabelle. Hier wird sie nur als gewöhnliches Modell bearbeitet, ohne Bezug zur Anmeldung.
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }

map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}


models+ {
    type "postgres"
    tableName "edit.nutzer"
    uid "model_edit_nutzer"
    title "Nutzer"
    sort+ { fieldName "nachname" }
    isEditable true
    permissions.edit "allow all"

    fields+ {
        name "id"
        type "integer"
        title "Identifier"
        isPrimaryKey true
        isRequired true
        permissions.edit "deny all"
        widget { type "input" }
    }

    fields+ {
        name "vorname"
        type "text"
        title "Vorname"
        isRequired true
        widget { type "input" }
    }

    fields+ {
        name "nachname"
        type "text"
        title "Nachname"
        isRequired true
        widget { type "input" }
        textSearch { type "any" }
    }

    fields+ {
        name "email"
        type "text"
        title "Email"
        isRequired true
        widget { type "input" }
    }

    fields+ {
        name "comment"
        type "text"
        title "Anmerkungen"
        widget { type "textarea" height 150 }
    }

    templates+ {
        subject "feature.title"
        type "html"
        text "{{nachname}}, {{vorname}}"
    }
}


{demo_osm_background}
