uid "field_related_feature"

title "Editieren N:1-Beziehung mit Auswahlliste"

metadata.keywords [ "edit" "datenbank" ]

metadata.abstract """
Einem POI eine Kategorie aus einer Auswahlliste zuordnen (N:1-Beziehung).

Im Reiter "Editieren" das Modell "POIs" wählen und ein Objekt öffnen. Das Feld "Category" bietet die vorhandenen Kategorien zur Auswahl an.

Das Feld ist vom Typ `relatedFeature`: `fromColumn "category_id"` ist die Fremdschlüsselspalte der POI-Tabelle, `toModel` und `toColumn "id"` bezeichnen das Kategorie-Modell und dessen Schlüssel. Das Widget `featureSelect` zeigt die Kategorien als Auswahlliste. Das Kategorie-Modell ist mit `permissions.edit "deny all"` schreibgeschützt und dient nur als Nachschlagetabelle.
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }


map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}

models+ {
    type "postgres"
    uid "model_poi_003"
    tableName "edit.poi_small"
    sort+ { fieldName "name" }
    title "POIs"
    isEditable true
    permissions.edit "allow all"

    fields+ { name "id" type "integer" title "Identifier" isPrimaryKey true permissions.edit "deny all" }
    fields+ { name "name" type "text" title "Name" isRequired true textSearch { type "any" } }
    fields+ { name "geom" type "geometry" title "Geometry" isRequired true }

    fields+ {
        name "category"
        title "Category"
        type "relatedFeature"
        fromColumn "category_id"
        toModel "model_category_003"
        toColumn "id"
        widget.type "featureSelect"
    }

    templates+ {
        subject "feature.title"
        type "html"
        text "{{@if feature.isNew}} Unbenannt {{@else}} {{name}} {{@end}}"
    }
}

models+ {
    type "postgres"
    uid "model_category_003"
    tableName "edit.category"
    title "Categories"
    sort+ { fieldName "name_de" }
    permissions.edit "deny all"

    fields+ { name "id" type "integer" title "Identifier" isPrimaryKey true permissions.edit "deny all" }
    fields+ { name "name_de" type "text" title "Name (DE)" isRequired true textSearch { type "any" } }

    templates+ { subject "feature.title" type "html" text "{{name_de}}" }
}

{demo_osm_background}
