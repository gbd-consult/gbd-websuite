uid "qgis_edit"

title "Editieren von QGIS Layern"

metadata.keywords [ "qgis" "edit" "datenbank" ]

metadata.abstract """
Bearbeiten von PostgreSQL-Daten in Layern, die der QGIS Server darstellt.

Im Panel "Editieren" einen der Layer "Points of interest" oder "Districts" wählen, oder in der Werkzeugleiste "Objekt zum Editieren auswählen" aktivieren und auf ein Objekt in der Karte klicken. Name, Geometrie und bei den Bezirken ein Kommentar lassen sich ändern, neue Objekte zeichnen und vorhandene löschen; die Kennung ist schreibgeschützt.

Beide Layer sind vom Typ `qgisflat` und wählen mit `sourceLayers.names` je einen Layer aus dem QGIS-Projekt aus. Daran hängt jeweils ein Modell `type "postgres"` mit `isEditable true` für dieselbe Tabelle, die das QGIS-Projekt verwendet. Die Felder legen Widgets (`input`, `textarea`), die Textsuche (`textSearch`) und mit `permissions.edit "deny all"` den Schreibschutz für den Primärschlüssel fest; Vorlagen für `feature.title` und `feature.label` bestimmen die Anzeige in den Listen.

`dbUid` nennt den Datenbank-Provider des Modells. Da die Modelle nicht an einem `postgres`-Layer hängen, wird sonst der erste konfigurierte PostgreSQL-Provider verwendet.
"""

actions+ { type "edit" }
client.addElements+ { tag "Sidebar.Edit" }
client.addElements+ { tag "Toolbar.Edit" }


map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}

map.layers+ {
    title "Points of interest"
    type "qgisflat"
    provider.path "/demos/poi_districts_postgres.qgs"
    sourceLayers.names [ "Points of interest" ]

    models+ {
        type "postgres"
        uid "model_poi_qgis_simple"
        dbUid "DEVDEMOS"
        tableName "edit.poi_small"
        isEditable true
        permissions.edit "allow all"

        fields+ {
            name "id"
            type "integer"
            title "Identifier"
            isPrimaryKey true
            isRequired true
            permissions.edit "deny all"
        }

        fields+ {
            name "name"
            type "text"
            title "Object name"
            widget { type "input" }
            textSearch { type "any" }
        }

        fields+ {
            name "geom"
            type "geometry"
            title "Geometry"
        }

        templates+ {
            subject "feature.title"
            type "html"
            text "{{name}} {{id}}"
        }

        templates+ {
            subject "feature.label"
            type "html"
            text "{{name}}"
        }
    }
}

map.layers+ {
    title "Districts"
    type "qgisflat"
    provider.path "/demos/poi_districts_postgres.qgs"
    sourceLayers.names [ "Districts" ]
    opacity 0.5

    models+ {
        type "postgres"
        uid "model_districts_qgis_simple"
        dbUid "DEVDEMOS"
        tableName "edit.district"
        isEditable true
        permissions.edit "allow all"

        fields+ {
            name "sid"
            type "text"
            title "Identifier"
            isPrimaryKey true
            isRequired true
            permissions.edit "deny all"
        }

        fields+ {
            name "name"
            type "text"
            title "Object name"
            widget { type "input" }
            textSearch { type "any" }
        }

        fields+ {
            name "description"
            type "text"
            title "Comments"
            widget { type "textarea" height 150 }
        }

        fields+ {
            name "geom"
            type "geometry"
            title "Geometry"
        }

        templates+ {
            subject "feature.title"
            type "html"
            text "{{name}} {{sid}}"
        }

        templates+ {
            subject "feature.label"
            type "html"
            text "{{name}}"
        }
    }

}

{demo_osm_background}
