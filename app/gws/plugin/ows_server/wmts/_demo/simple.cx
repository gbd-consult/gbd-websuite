uid "service_wmts_simple_demo"

title "WMTS Dienst, einfach"

metadata.keywords [ "ows-dienste" "wmts" ]

metadata.abstract """
Ein einfacher, von der WebSuite bereitgestellter WMTS-Dienst mit einem OpenStreetMap-Layer.

Der Dienst kann über die Service-URL in einer externen Anwendung wie QGIS eingebunden werden; dort stehen Kachelmatrix-Sätze für EPSG:3857, EPSG:25832 und EPSG:25833 zur Auswahl.

Konfiguriert ist ein `owsServices`-Eintrag vom Typ `wmts` mit `supportedCrs [ 3857 25832 25833 ]`; für jedes KBS wird ein eigener `TileMatrixSet` erzeugt, `map.extent` begrenzt die Kachelmatrix. Den Inhalt liefert ein Kachellayer (`type "tile"`) mit `withCache true`.

[Service URL](/_/owsService/serviceUid/service_wmts_simple?request=GetCapabilities)

[Demo QGIS Project](/ows_services.qgs)
"""

owsServices+ {
    type "wmts"
    uid "service_wmts_simple"
    supportedCrs [ 3857 25832 25833 ]
    metadata {
        abstract "Simple WMTS service"
        keywords ["test" "wmts" "demo"]
        name "WMTS_SIMPLE"
        title "Simple WMTS"
        {demo_metadata}
    }
}

map.extent [
    {demo_point_duesseldorf_3857[0] - 30000}
    {demo_point_duesseldorf_3857[1] - 30000}
    {demo_point_duesseldorf_3857[0] + 30000}
    {demo_point_duesseldorf_3857[1] + 30000}
]

map.layers+ {
    title "Open Street Map"
    type "tile"
    provider.url "https://geoservices.gbd-consult.de/xyz/light/{{z}}/{{x}}/{{y}}.png?key=gwsdemo"

    withCache true

    legend {
        type "static"
        path "osm_legend.png"
    }

}
