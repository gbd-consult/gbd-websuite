uid "tile_reprojected"

title "Kachellayer, umprojiziert"

metadata.keywords [ "koordinatensysteme" "rasterdaten" ]

metadata.abstract """
Ein XYZ-Kacheldienst, der auf dem Server in ein anderes KBS umprojiziert wird.

Die Karte ist mit `crs 25830` (ETRS89 / UTM Zone 30N) konfiguriert, die Kacheln der Quelle liegen in Web Mercator vor. Mit `display "tile"` holt der Server die Quellkacheln, projiziert sie um und liefert sie im Raster der Karte aus; die Kacheln werden dabei auf dem Server zwischengespeichert.
"""

map {
    crs 25830
    extent {demo_make_extent(1181583, 5720282, 1000)}
    zoom.initScale 500000
}

map.layers+ {
    title "Open Street Map"
    type "tile"
    provider.url "https://geoservices.gbd-consult.de/xyz/light/{{z}}/{{x}}/{{y}}.png?key=gwsdemo"

    display "tile"
}
