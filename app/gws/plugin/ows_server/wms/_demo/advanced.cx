uid "service_wms_advanced_demo"

title "WMS Dienst, erweiterte Konfiguration"

metadata.keywords [ "ows-dienste" "wms" "qgis" "koordinatensysteme" ]

metadata.abstract """
Ein von der WebSuite bereitgestellter WMS-Dienst mit erweiterten Einstellungen: QGIS- und kaskadierte externe WMS-Layer, Maßstabsbereiche pro Layer, mehrere KBS, mehrere Bildformate und eine HTML-Vorlage für die Objektabfrage.

Beim Laden des Dienstes in einer externen Anwendung wie QGIS finden sich folgende Layer:

- In Maßstäben kleiner als 1:50.000 der Layer „Districts“ aus einem QGIS-Projekt (`zoom.minScale 50000`).
- Ab 1:50.000 der Layer „Points of interest“ aus demselben QGIS-Projekt (`zoom.maxScale 50000`).
- Ab 1:5.000 die Flurstücke aus `wms_nw_alkis` und die Orthophotos aus `wms_nw_dop` des Landes NRW, als `wmsflat`-Layer kaskadiert.
- Ein OpenStreetMap-Kachellayer mit statischer Legende.

Konfiguriert sind am Dienst:

- `supportedCrs [ 4326 3857 25832 ]`: die KBS, in denen Karten angefordert werden können.
- `imageFormats`: Bildformate mit eigenen MIME-Typen und Optionen, z. B. `image/png; mode=8bit` mit Palette oder `image/jpeg; quality=low` mit niedriger Qualität und gelbem Hintergrund.
- `templates` mit dem Subject `ows.GetFeatureInfo` und `mimeTypes [ "html" ]`: eine HTML-Ausgabe der Objektabfrage. Abfragbar sind die QGIS-Layer über ihre `finders` und die Flurstücke über die Objektinformation des Quelldienstes.

[Service URL](/_/owsService/serviceUid/service_wms_advanced?request=GetCapabilities)

[Demo QGIS Project](/ows_services.qgs)
"""

owsServices+ {
    type "wms"
    uid "service_wms_advanced"

    supportedCrs [ 4326 3857 25832 ]

    metadata {
        abstract "Advanced WMS service"
        keywords ["test" "wms" "qgis" "demo"]
        name "ADVANCED_WMS"
        title "Advanced WMS"
        catalogUid "ows_service_wms_advanced"
        {demo_metadata}
    }

    imageFormats+ {
        mimeTypes [ "image/png" "image/png; mode=32bit" ]
        options { mode "RGBA" }
    }
    imageFormats+ {
        mimeTypes [ "image/png; mode=8bit" ]
        options { mode "P" }
    }
    imageFormats+ {
        mimeTypes [ "image/jpeg" "image/jpeg; quality=high" ]
        options { quality 50 background "cyan" }
    }
    imageFormats+ {
        mimeTypes [ "image/jpeg; quality=low" ]
        options { quality 10 background "yellow" }
    }

    templates+ {
        subject "ows.GetFeatureInfo"
        type "html"
        path "feature_info.cx.html"
        mimeTypes [ "html" ]
    }
}

map.extent [
    {demo_point_duesseldorf_3857[0] - 30000}
    {demo_point_duesseldorf_3857[1] - 30000}
    {demo_point_duesseldorf_3857[0] + 30000}
    {demo_point_duesseldorf_3857[1] + 30000}
]

map.zoom { minScale 500 maxScale 400000 }

map.layers+ {
    title "Points of interest"
    type "qgisflat"
    provider.path "/demos/poi_districts_postgres.qgs"
    sourceLayers.names [ "Points of interest" ]
    zoom { maxScale 50000 }
    finders+ { type "postgres" tableName "edit.poi" }
    ows.xmlns "demo"
}

map.layers+ {
    type "wmsflat"
    title "NRW Flurstücke"
    provider.url "https://www.wms.nrw.de/geobasis/wms_nw_alkis"
    sourceLayers.names [ "adv_alkis_flurstuecke" ]
    zoom { maxScale 5000 }
    metadata.attribution "© Geobasis NRW"
    metadata.attributionUrl "http://www.geobasis.nrw.de"
}


map.layers+ {
    title "Districts"
    type "qgisflat"
    provider.path "/demos/poi_districts_postgres.qgs"
    sourceLayers.names [ "Districts" ]
    zoom { minScale 50000 }
    finders+ { type "postgres" tableName "edit.district" }
}


map.layers+ {
    type "wmsflat"
    title "NRW DOP"
    provider.url "https://www.wms.nrw.de/geobasis/wms_nw_dop"
    sourceLayers.names [ "nw_dop_rgb" ]
    zoom { maxScale 5000 }
    metadata.attribution "© Geobasis NRW"
    metadata.attributionUrl "http://www.geobasis.nrw.de"
}

map.layers+ {
    title "Open Street Map"
    type "tile"
    provider.url "https://geoservices.gbd-consult.de/xyz/light/{{z}}/{{x}}/{{y}}.png?key=gwsdemo"
    withCache true
    legend {
        type "static"
        path "osm_legend.png"
    }
}
