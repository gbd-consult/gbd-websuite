uid "auth_layer"

title "Layer-Sichtbarkeit nach Rolle"

metadata.keywords [ "authentifizierung" "karte" ]

metadata.abstract """
Layer, die nur für bestimmte Rollen sichtbar sind.

Das Projekt selbst ist mit `access "allow user, deny all"` nur für angemeldete Nutzer zugänglich. Der Layer "POIs" ist mit `access "allow groupA, deny all"` nur für die Rolle `groupA` sichtbar, der Layer "Districts" entsprechend nur für `groupB`.

Zum Vergleich mit `demo1` (Rolle `groupA`) oder `demo3` (Rolle `groupB`) anmelden, Passwort jeweils **demo**. Im Reiter "Layer" der Seitenleiste erscheint dann nur der Layer der eigenen Rolle neben der Hintergrundkarte.
"""

access "allow user, deny all"

map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 150000
    zoom.maxScale  1000000
}

map.layers+ {
    title "POIs"
    type "postgres"
    tableName "edit.poi_small"
    access "allow groupA, deny all"
}

map.layers+ {
    title "Districts"
    type "postgres"
    tableName "edit.district"
    access "allow groupB, deny all"
}

{demo_osm_background}
