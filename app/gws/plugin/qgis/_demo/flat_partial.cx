uid "qgis_flat_partial"

title "QGIS Layer, flach mit Layerauswahl"

metadata.keywords [ "qgis" "karte" ]

metadata.abstract """
Ein einzelner WebSuite-Layer, der nur ausgewählte Layer eines QGIS-Projekts zeigt.

Im Layer-Panel erscheint nur der Layer "Bars und Kneipen in Düsseldorf"; die übrigen Layer des Projekts werden nicht dargestellt.

Der Layer `type "qgisflat"` rendert die Quelllayer als ein Bild. Mit `sourceLayers.names` werden die zu verwendenden Layer über ihre Namen im QGIS-Projekt ausgewählt, hier "Bar" und "Kneipe". Ohne `sourceLayers` zeigt der Layer das ganze Projekt, siehe die Demo "QGIS Layer, flach".
"""

map {
    center {demo_point_duesseldorf_3857}
    zoom.initScale 15000
    zoom.maxScale  1000000
}

map.layers+ {
    title "Bars und Kneipen in Düsseldorf"
    type "qgisflat"
    provider.path "/demos/poi_geojson.qgs"
    sourceLayers.names [
        "Bar"
        "Kneipe"
    ]
}

{demo_osm_background}
